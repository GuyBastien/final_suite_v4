<?xml version="1.0"?>
<!-- This file is part of the Tryton mobile_payment module. -->
<tryton>
    <data>
        <record model="ir.ui.view" id="sale_view_form">
            <field name="model">sale.point.sale</field>
            <field name="inherit" ref="sale_point_quick.sale_view_form"/>
            <field name="name">sale_form</field>
        </record>
        <record model="ir.model.button" id="sale_pay_mobile_button">
            <field name="model" search="[('model', '=', 'sale.point.sale')]"/>
            <field name="name">pay_mobile</field>
            <field name="string">Pay by Mobile</field>
        </record>
        <record model="ir.ui.view" id="pay_start_view_form">
            <field name="model">mobile.payment.pay.start</field>
            <field name="type">form</field>
            <field name="name">pay_start_form</field>
        </record>
        <record model="ir.ui.view" id="pay_result_view_form">
            <field name="model">mobile.payment.pay.result</field>
            <field name="type">form</field>
            <field name="name">pay_result_form</field>
        </record>
        <record model="ir.action.wizard" id="wizard_pay">
            <field name="name">Mobile Payment</field>
            <field name="wiz_name">mobile.payment.pay</field>
        </record>
    </data>
</tryton>

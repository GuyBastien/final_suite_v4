<?xml version="1.0"?>
<!-- This file is part of the Tryton mobile_payment module. -->
<data>
    <xpath expr="/form/group[@id='buttons']/button[@name='cancel']" position="before">
        <button name="pay_mobile" icon="tryton-mobile-payment"/>
    </xpath>
    <xpath expr="/form/notebook" position="inside">
        <page string="Mobile Payments" id="mobile_payments">
            <field name="mobile_transactions" colspan="4"
                view_ids="mobile_payment.sale_tx_view_list"/>
            <field name="mobile_pending" invisible="1"/>
        </page>
    </xpath>
</data>

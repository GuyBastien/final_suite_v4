<form col="2">
    <label name="order_ref"/>
    <field name="order_ref"/>
    <label name="state"/>
    <field name="state"/>
    <label name="channel"/>
    <field name="channel"/>
    <label name="ussd_code"/>
    <field name="ussd_code"/>
    <label name="ussd_uri"/>
    <field name="ussd_uri" widget="url"/>
    <label name="receipt"/>
    <field name="receipt"/>
    <label name="checkout_url"/>
    <field name="checkout_url" widget="url"/>
    <label name="qr_code"/>
    <field name="qr_code" widget="image" width="260" height="260"/>
    <label name="message"/>
    <field name="message" yexpand="0"/>
    <label name="share_whatsapp"/>
    <field name="share_whatsapp" widget="url"/>
    <label name="share_sms"/>
    <field name="share_sms" widget="url"/>

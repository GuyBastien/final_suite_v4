    <label name="state"/>
    <field name="state"/>
    <label name="document"/>
    <field name="document"/>
    <label name="account"/>
    <field name="account"/>
    <label name="amount"/>
    <field name="amount"/>
    <label name="phone"/>
    <field name="phone"/>
    <label name="channel"/>
    <field name="channel"/>
    <label name="receipt"/>
    <field name="receipt"/>
    <label name="checkout_url"/>
    <field name="checkout_url" widget="url" colspan="3"/>
    <label name="ussd_code"/>
    <field name="ussd_code"/>
    <label name="ussd_uri"/>
    <field name="ussd_uri" widget="url"/>
    <label name="instructions"/>
    <field name="instructions" colspan="3" yexpand="0"/>
    <label name="qr_code"/>
    <field name="qr_code" widget="image" width="220" height="220" colspan="3"/>
    <label name="share_whatsapp"/>
    <field name="share_whatsapp" widget="url"/>
    <label name="share_sms"/>

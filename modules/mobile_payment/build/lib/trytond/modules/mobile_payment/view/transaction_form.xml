    <field name="payment"/>
    <label name="orphan"/>
    <field name="orphan" xexpand="0"/>
    <label name="manual"/>
    <field name="manual" xexpand="0"/>
    <label name="confirmed_by"/>
    <field name="confirmed_by"/>
    <newline/>
    <label name="message"/>
    <field name="message" colspan="3" yexpand="0"/>
    <group id="buttons" colspan="4" col="-1">
        <button name="cancel" icon="tryton-cancel"/>
        <button name="request" icon="tryton-forward"/>
        <button name="check" icon="tryton-refresh"/>
        <button name="confirm_ussd" icon="tryton-ok"/>
        <button name="resolve" icon="tryton-ok"/>

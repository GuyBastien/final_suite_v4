msgctxt "view:mobile.payment.account:"
msgid "USSD Payment"
msgstr "Peman USSD"

msgctxt "view:mobile.payment.pay.result:"
msgid ""
"Press Verify Payment once the customer has paid (link/QR code), or after "
"typing the receipt number received by SMS (USSD)."
msgstr ""
"Peze Verifye peman an lè kliyan an fin peye (lyen/kòd QR), oswa apre w tape "
"nimewo resi li resevwa pa SMS (USSD)."


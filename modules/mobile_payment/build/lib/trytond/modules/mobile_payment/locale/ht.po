msgstr ""
"Montre l bay kliyan an : lè l eskane l ak kamera telefòn nan, paj peman "
"operatè a ouvri."

msgctxt "help:mobile.payment.transaction,document:"
msgid "The ticket, order or stay paid by this transaction."
msgstr "Tikè a, kòmand lan oswa sejou tranzaksyon sa a peye."

msgctxt "help:mobile.payment.transaction,qr_code:"
msgid ""
"The customer scans it with the phone camera to open the payment page of the "
"operator. Needs the python package segno."
msgstr ""
"Kliyan an eskane l ak kamera telefòn nan pou l ouvri paj peman operatè a. "
"Mande pakè python segno a."

msgctxt "model:ir.message,text:msg_no_booking_rule"

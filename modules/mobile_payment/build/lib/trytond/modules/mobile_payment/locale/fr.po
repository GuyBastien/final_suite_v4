msgctxt "model:ir.message,text:msg_account_name_unique"
msgid "The name of the mobile payment account must be unique per company."
msgstr "Le nom du compte de paiement mobile doit être unique par société."

msgctxt "model:ir.message,text:msg_amount_too_high"
msgid ""
"The amount %(amount)s is higher than the amount still due on the ticket "
"(%(due)s)."
msgstr ""
"Le montant %(amount)s dépasse le montant encore dû sur le ticket (%(due)s)."

msgctxt "model:ir.message,text:msg_cancel_pending"
msgid ""
"The ticket \"%(sale)s\" has a mobile payment waiting for the customer. "
"Cancel or expire it first."
msgstr ""
"Le ticket « %(sale)s » a un paiement mobile en attente du client. Annulez-le"
" ou laissez-le expirer d'abord."

msgctxt "model:ir.message,text:msg_delete_state"
msgid ""
"The mobile payment \"%(transaction)s\" was sent to the operator and cannot "
"be deleted."
msgstr ""
"Le paiement mobile « %(transaction)s » a été envoyé à l'opérateur et ne peut"
" pas être supprimé."

msgctxt "model:ir.message,text:msg_invalid_phone"
msgid ""
"The phone number \"%(phone)s\" is not a valid Haitian number. Use 8 digits "
"or 509 followed by 8 digits."
msgstr ""
"Le numéro « %(phone)s » n'est pas un numéro haïtien valide. Utilisez 8 "
"chiffres ou 509 suivi de 8 chiffres."

msgctxt "model:ir.message,text:msg_network_error"
msgid "The operator cannot be reached: %(error)s"
msgstr "L'opérateur est injoignable : %(error)s"

msgctxt "model:ir.message,text:msg_no_provider"
msgid ""
"The provider \"%(provider)s\" does not implement \"%(action)s\". Install its"
" module."
msgstr ""
"L'opérateur « %(provider)s » n'implémente pas « %(action)s ». Installez son "
"module."

msgctxt "model:ir.message,text:msg_notify_expired"
msgid "%(provider)s: the request %(order)s was not paid in time."
msgstr "%(provider)s : la demande %(order)s n'a pas été payée à temps."

msgctxt "model:ir.message,text:msg_notify_expired_title"
msgid "Mobile payment expired"
msgstr "Paiement mobile expiré"

msgctxt "model:ir.message,text:msg_notify_failed"
msgid "%(provider)s: the payment %(order)s failed."
msgstr "%(provider)s : le paiement %(order)s a échoué."

msgctxt "model:ir.message,text:msg_notify_failed_title"
msgid "Mobile payment refused"
msgstr "Paiement mobile refusé"

msgctxt "model:ir.message,text:msg_notify_orphan"
msgid ""
"%(provider)s: %(amount)s received for %(order)s but it cannot be booked on "
"the ticket. Check it."
msgstr ""
"%(provider)s : %(amount)s reçu pour %(order)s mais il ne peut pas être "
"enregistré sur le ticket. Vérifiez."

msgctxt "model:ir.message,text:msg_notify_orphan_title"
msgid "Mobile payment to review"
msgstr "Paiement mobile à vérifier"

msgctxt "model:ir.message,text:msg_notify_paid"
msgid "%(provider)s: %(amount)s received for %(order)s."
msgstr "%(provider)s : %(amount)s reçu pour %(order)s."

msgctxt "model:ir.message,text:msg_notify_paid_title"
msgid "Mobile payment received"
msgstr "Paiement mobile reçu"

msgctxt "model:ir.message,text:msg_order_unique"
msgid "The order ID of a mobile payment must be unique per company."
msgstr ""
"La référence de commande d'un paiement mobile doit être unique par société."

msgctxt "model:ir.message,text:msg_orphan_message"
msgid ""
"Confirmed by the operator but not booked on the ticket (closed, already paid"
" or different amount). Refund or fix manually. %(message)s"
msgstr ""
"Confirmé par l'opérateur mais non enregistré sur le ticket (clos, déjà payé "
"ou montant différent). Remboursez ou corrigez manuellement. %(message)s"

msgctxt "model:ir.message,text:msg_sale_not_open"
msgid "The ticket \"%(sale)s\" is not open: it cannot receive a mobile payment."
msgstr ""
"Le ticket « %(sale)s » n'est pas ouvert : il ne peut pas recevoir de "
"paiement mobile."


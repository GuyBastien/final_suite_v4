msgctxt "help:mobile.payment.account,company:"
msgid "The company that receives the money."
msgstr "La société qui reçoit l'argent."

msgctxt "help:mobile.payment.account,expiry_minutes:"
msgid ""
"A request still unpaid after this delay is expired by the scheduler (after "
"one last check with the operator)."
msgstr ""
"Une demande encore impayée après ce délai est expirée par le planificateur "
"(après une dernière vérification auprès de l'opérateur)."

msgctxt "help:mobile.payment.account,last_test:"
msgid "Result of the last test of the credentials."
msgstr "Résultat du dernier test des identifiants."

msgctxt "help:mobile.payment.account,method:"
msgid ""
"Payment method on which confirmed payments are booked. Its account is the "
"clearing account of the operator."
msgstr ""
"Mode de paiement sur lequel les paiements confirmés sont enregistrés. Son "
"compte est le compte de liaison de l'opérateur."

msgctxt "help:mobile.payment.account,name:"
msgid "Name shown to the cashier, for example 'MonCash Boutique'."
msgstr "Nom affiché au caissier, par exemple « MonCash Boutique »."

msgctxt "help:mobile.payment.account,provider:"
msgid ""
"Mobile money operator. The list is extended by the provider modules "
"(moncash, natcash)."
msgstr ""
"Opérateur de monnaie mobile. La liste est étendue par les modules opérateurs"
" (moncash, natcash)."

msgctxt "help:mobile.payment.account,sandbox:"
msgid ""
"Use the test platform of the operator. No real money moves. Untick only "
"after the operator activated the live credentials."
msgstr ""
"Utilise la plateforme de test de l'opérateur. Aucun argent réel ne circule. "
"Ne décochez qu'après l'activation des identifiants réels par l'opérateur."

msgctxt "help:mobile.payment.pay.result,checkout_url:"
msgid "Give this link to the customer (or open it on the terminal)."
msgstr "Donnez ce lien au client (ou ouvrez-le sur le terminal)."

msgctxt "help:mobile.payment.pay.start,account:"
msgid "MonCash, NatCash... account that receives the money."
msgstr "Compte MonCash, NatCash… qui reçoit l'argent."

msgctxt "help:mobile.payment.pay.start,amount:"
msgid "Amount asked to the customer. At most the amount still due."
msgstr "Montant demandé au client. Au plus le montant encore dû."

msgctxt "help:mobile.payment.pay.start,phone:"
msgid "Optional. 8 digits or 509XXXXXXXX. Speeds up NatCash."
msgstr "Facultatif. 8 chiffres ou 509XXXXXXXX. Accélère NatCash."

msgctxt "help:mobile.payment.transaction,account:"
msgid "Account of the operator that receives the payment."
msgstr "Compte de l'opérateur qui reçoit le paiement."

msgctxt "help:mobile.payment.transaction,amount:"
msgid "Amount asked to the customer."
msgstr "Montant demandé au client."

msgctxt "help:mobile.payment.transaction,checkout_url:"
msgid ""
"Page of the operator where the customer confirms the payment. Open it on the"
" customer phone or in a browser."
msgstr ""
"Page de l'opérateur où le client confirme le paiement. Ouvrez-la sur le "
"téléphone du client ou dans un navigateur."

msgctxt "help:mobile.payment.transaction,expires_at:"
msgid "After this moment the request is expired by the scheduler."
msgstr "Après cet instant, la demande est expirée par le planificateur."

msgctxt "help:mobile.payment.transaction,message:"
msgid "Last message of the operator."
msgstr "Dernier message de l'opérateur."

msgctxt "help:mobile.payment.transaction,order_ref:"
msgid "Unique reference sent to the operator."
msgstr "Référence unique envoyée à l'opérateur."

msgctxt "help:mobile.payment.transaction,orphan:"
msgid ""
"The operator confirmed a payment that cannot be booked on the ticket (ticket"
" cancelled, already paid, or different amount). Refund or fix manually, then"
" tick it off."
msgstr ""
"L'opérateur a confirmé un paiement qui ne peut pas être enregistré sur le "
"ticket (ticket annulé, déjà payé ou montant différent). Remboursez ou "
"corrigez manuellement, puis cochez."

msgctxt "help:mobile.payment.transaction,payer:"
msgid "Account of the customer who paid."
msgstr "Compte du client qui a payé."

msgctxt "help:mobile.payment.transaction,payment:"
msgid "Payment of the ticket created when the operator confirmed."
msgstr "Paiement du ticket créé lorsque l'opérateur a confirmé."

msgctxt "help:mobile.payment.transaction,phone:"
msgid ""
"Mobile number of the customer (8 digits or 509XXXXXXXX). Optional for "
"MonCash, used by NatCash to skip the phone page."
msgstr ""
"Numéro mobile du client (8 chiffres ou 509XXXXXXXX). Facultatif pour "
"MonCash, utilisé par NatCash pour passer la page du téléphone."

msgctxt "help:mobile.payment.transaction,provider:"
msgid "Mobile money operator of the account."
msgstr "Opérateur de monnaie mobile du compte."

msgctxt "help:mobile.payment.transaction,provider_ref:"
msgid "Transaction number given by the operator."
msgstr "Numéro de transaction donné par l'opérateur."

msgctxt "help:mobile.payment.transaction,sale:"
msgid "Point of sale ticket paid by this transaction."
msgstr "Ticket du point de vente payé par cette transaction."

msgctxt "help:mobile.payment.transaction,state:"
msgid ""
"Pending: waiting for the customer. Paid: confirmed by the operator. Expired:"
" not paid in time."
msgstr ""
"En attente : le client n'a pas encore payé. Payé : confirmé par l'opérateur."
" Expiré : non payé à temps."

msgctxt "help:sale.point.payment.method,mobile:"
msgid ""
"This method is used by a mobile payment account. Payments on it are created "
"by the confirmation of the provider, not typed by the cashier."
msgstr ""
"Ce mode est utilisé par un compte de paiement mobile. Les paiements sont "
"créés par la confirmation de l'opérateur, pas saisis par le caissier."

msgctxt "help:sale.point.sale,mobile_transactions:"
msgid "MonCash, NatCash and other mobile payments of this ticket."
msgstr "Paiements MonCash, NatCash et autres paiements mobiles de ce ticket."


msgid "Link / QR Code"
msgstr "Lien / code QR"

msgctxt "selection:mobile.payment.transaction,channel:"
msgid "USSD"
msgstr "USSD"

msgctxt "view:mobile.payment.account:"
msgid "USSD Payment"
msgstr "Paiement USSD"

msgctxt "view:mobile.payment.pay.result:"
msgid ""
"Press Verify Payment once the customer has paid (link/QR code), or after "
"typing the receipt number received by SMS (USSD)."
msgstr ""
"Cliquez sur Vérifier le paiement une fois que le client a payé (lien/code "
"QR), ou après avoir saisi le numéro de reçu reçu par SMS (USSD)."

msgctxt "view:mobile.payment.transaction:"
msgid "Pay Now"
msgstr "Payer maintenant"


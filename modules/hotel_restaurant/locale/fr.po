msgctxt "field:restaurant.restaurant,hotel:"
msgid "Hotel"
msgstr "Hôtel"

msgctxt "help:hotel.reservation,restaurant_orders:"
msgid "Orders of the restaurant of the hotel for this stay."
msgstr "Commandes du restaurant de l'hôtel pour ce séjour."

msgctxt "help:hotel.restaurant.booking,restaurant_reservation:"
msgid "Reservation of the restaurant that replaces this one."
msgstr "Réservation du restaurant qui remplace celle-ci."

msgctxt "help:hotel.restaurant.table,restaurant_table:"
msgid "Table of the restaurant that replaces this one."
msgstr "Table du restaurant qui remplace celle-ci."

msgctxt "help:restaurant.order,reservation:"
msgid "Checked-in stay of the guest. Needed to charge the order to the room."
msgstr ""
"Séjour en cours du client. Nécessaire pour imputer la commande sur la "
"chambre."

msgctxt "help:restaurant.payment,hotel_charge:"
msgid "Charge of the hotel stay created by this payment."
msgstr "Imputation du séjour d'hôtel créée par ce paiement."

msgctxt "help:restaurant.reservation,hotel_reservation:"
msgid ""
"Stay of the hotel guest who books the table. The order of the table is then "
"linked to the stay."
msgstr ""
"Séjour du client de l'hôtel qui réserve la table. La commande de la table "
"est alors liée au séjour."

msgctxt "help:restaurant.restaurant,hotel:"
msgid ""
"Hotel to which this restaurant belongs. The guests of this hotel can charge "
"their orders to their room."
msgstr ""
"Hôtel auquel appartient ce restaurant. Les clients de cet hôtel peuvent "
"imputer leurs commandes sur leur chambre."

msgctxt "model:ir.message,text:msg_area"
msgid "Hotel"
msgstr "Hôtel"

msgctxt "model:ir.message,text:msg_charge_billed"
msgid ""
"The room charge of order \"%(order)s\" is already billed with the stay and "
"cannot be removed."
msgstr ""
"L'imputation sur la chambre de la commande « %(order)s » est déjà facturée "
"avec le séjour et ne peut pas être supprimée."

msgctxt "model:ir.message,text:msg_charge_description"
msgid "Restaurant - order %(order)s"
msgstr "Restaurant - commande %(order)s"

msgctxt "model:ir.message,text:msg_no_hotel"
msgid "Restaurant \"%(restaurant)s\" has no hotel. Choose the hotel first."
msgstr ""
"Le restaurant « %(restaurant)s » n'a pas d'hôtel. Choisissez d'abord "
"l'hôtel."

msgctxt "model:ir.message,text:msg_no_room_product"
msgid ""
"Hotel \"%(hotel)s\" has no Room Charge Product. Set it to bill the "
"restaurant to the room."
msgstr ""
"L'hôtel « %(hotel)s » n'a pas d'article d'imputation sur la chambre. "
"Renseignez-le pour facturer le restaurant sur la chambre."

msgctxt "model:ir.message,text:msg_other_hotel"
msgid ""
"Order \"%(order)s\" cannot be linked to a stay of another hotel than "
"\"%(hotel)s\"."
msgstr ""
"La commande « %(order)s » ne peut pas être liée à un séjour d'un autre hôtel"
" que « %(hotel)s »."

msgctxt "model:ir.message,text:msg_room_locked"
msgid ""
"The room charge of order \"%(order)s\" cannot be changed. Delete it and "
"enter it again."
msgstr ""
"L'imputation sur la chambre de la commande « %(order)s » ne peut pas être "
"modifiée. Supprimez-la et saisissez-la à nouveau."

msgctxt "model:ir.message,text:msg_room_no_stay"
msgid ""
"Order \"%(order)s\" can only be charged to the room of a checked-in stay. "
"Choose the hotel stay first."
msgstr ""
"La commande « %(order)s » ne peut être imputée que sur la chambre d'un "
"séjour en cours. Choisissez d'abord le séjour."

msgctxt "model:ir.model.button,string:restaurant_import_hotel_bookings_button"
msgid "Import Hotel Table Bookings"
msgstr "Importer les réservations de table de l'hôtel"

msgctxt "model:ir.ui.menu,name:menu_restaurant_reservation"
msgid "Restaurant Reservations"
msgstr "Réservations du restaurant"

msgctxt "selection:restaurant.payment,method:"
msgid "Room Charge"
msgstr "Imputation sur la chambre"

msgctxt "view:hotel.reservation:"
msgid "Restaurant"
msgstr "Restaurant"

msgctxt "model:ir.message,text:msg_open_order_checkout"
msgid ""
"Order \"%(order)s\" of stay \"%(reservation)s\" still has a balance due. "
"Charge it to the room or settle it before the check-out."
msgstr ""
"La commande \"%(order)s\" du séjour \"%(reservation)s\" a encore un solde à "
"payer. Portez-la sur la chambre ou réglez-la avant le départ."

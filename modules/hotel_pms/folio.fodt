<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:form="urn:oasis:names:tc:opendocument:xmlns:form:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" xmlns:number="urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0" xmlns:script="urn:oasis:names:tc:opendocument:xmlns:script:1.0" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta/>
 <office:font-face-decls>
  <style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'" style:font-family-generic="swiss" style:font-pitch="variable"/>
 </office:font-face-decls>
 <office:styles>
  <style:default-style style:family="paragraph">
   <style:text-properties style:font-name="Liberation Sans" fo:font-size="10pt"/>
  </style:default-style>
  <style:style style:name="Standard" style:family="paragraph" style:class="text"/>
  <style:style style:name="Table_20_Contents" style:display-name="Table Contents" style:family="paragraph" style:parent-style-name="Standard"/>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="pm1">
   <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/>
  </style:page-layout>
  <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.3cm"/>
   <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="Sub" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:text-align="center"/>
  </style:style>
  <style:style style:name="Head" style:family="paragraph" style:parent-style-name="Table_20_Contents">
   <style:paragraph-properties fo:text-align="center"/>
   <style:text-properties fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="Left" style:family="paragraph" style:parent-style-name="Table_20_Contents"/>
  <style:style style:name="Right" style:family="paragraph" style:parent-style-name="Table_20_Contents">
   <style:paragraph-properties fo:text-align="end"/>
  </style:style>
  <style:style style:name="RightBold" style:family="paragraph" style:parent-style-name="Table_20_Contents">
   <style:paragraph-properties fo:text-align="end"/>
   <style:text-properties fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="Bold" style:family="paragraph" style:parent-style-name="Table_20_Contents">
   <style:text-properties fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="Gap" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:margin-top="0.4cm"/>
   <style:text-properties fo:font-weight="bold" fo:font-size="12pt"/>
  </style:style>
  <style:style style:name="T" style:family="table">
   <style:table-properties style:width="26.7cm" table:align="margins"/>
  </style:style>
  <style:style style:name="C" style:family="table-cell">
   <style:table-cell-properties fo:padding="0.08cm" fo:border="0.5pt solid #000000"/>
  </style:style>
  <style:style style:name="L" style:family="table-cell">
   <style:table-cell-properties fo:padding="0.08cm" fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:border-top="none" fo:border-bottom="none"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="pm1"/>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Standard"><text:placeholder text:placeholder-type="text">&lt;for each=&quot;reservation in records&quot;&gt;</text:placeholder></text:p>
   <text:p text:style-name="Title">Guest Folio <text:placeholder text:placeholder-type="text">&lt;reservation.number&gt;</text:placeholder></text:p>
   <text:p text:style-name="Sub"><text:placeholder text:placeholder-type="text">&lt;reservation.hotel.rec_name&gt;</text:placeholder> — <text:placeholder text:placeholder-type="text">&lt;reservation.party.rec_name&gt;</text:placeholder></text:p>
   <text:p text:style-name="Sub"><text:placeholder text:placeholder-type="text">&lt;format_datetime(reservation.start, user.language)&gt;</text:placeholder> → <text:placeholder text:placeholder-type="text">&lt;format_datetime(reservation.end, user.language)&gt;</text:placeholder></text:p>
   <text:p text:style-name="Gap">Rooms</text:p>
   <table:table table:name="T1" table:style-name="T">
    <table:table-column/>
    <table:table-column/>
    <table:table-column/>
    <table:table-column/>
    <table:table-column/>
    <table:table-header-rows>
     <table:table-row>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Head">Room</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Head">Type</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Head">Billed As</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Head">Quantity</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Head">Amount</text:p>
     </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="L" table:number-columns-spanned="5" office:value-type="string">
      <text:p text:style-name="Left"><text:placeholder text:placeholder-type="text">&lt;for each=&quot;line in reservation.lines&quot;&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Left"><text:placeholder text:placeholder-type="text">&lt;line.room.rec_name if line.room else &apos;&apos;&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Left"><text:placeholder text:placeholder-type="text">&lt;line.room_type.rec_name&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Left"><text:placeholder text:placeholder-type="text">&lt;line.billed_as or &apos;&apos;&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Right"><text:placeholder text:placeholder-type="text">&lt;line.quantity or 0&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Right"><text:placeholder text:placeholder-type="text">&lt;format_currency(line.amount or 0, user.language, reservation.currency)&gt;</text:placeholder></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="L" table:number-columns-spanned="5" office:value-type="string">
      <text:p text:style-name="Left"><text:placeholder text:placeholder-type="text">&lt;/for&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Gap">Charges</text:p>
   <table:table table:name="T2" table:style-name="T">
    <table:table-column/>
    <table:table-column/>
    <table:table-column/>
    <table:table-column/>
    <table:table-header-rows>
     <table:table-row>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Head">Description</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Head">Quantity</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Head">Unit Price</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Head">Amount</text:p>
     </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="L" table:number-columns-spanned="4" office:value-type="string">
      <text:p text:style-name="Left"><text:placeholder text:placeholder-type="text">&lt;for each=&quot;charge in reservation.charges&quot;&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Left"><text:placeholder text:placeholder-type="text">&lt;charge.description or charge.product.rec_name&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Right"><text:placeholder text:placeholder-type="text">&lt;charge.quantity&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Right"><text:placeholder text:placeholder-type="text">&lt;format_currency(charge.unit_price, user.language, reservation.currency)&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="C" office:value-type="string">
      <text:p text:style-name="Right"><text:placeholder text:placeholder-type="text">&lt;format_currency(charge.amount, user.language, reservation.currency)&gt;</text:placeholder></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="L" table:number-columns-spanned="4" office:value-type="string">
      <text:p text:style-name="Left"><text:placeholder text:placeholder-type="text">&lt;/for&gt;</text:placeholder></text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Gap">Total: <text:placeholder text:placeholder-type="text">&lt;format_currency(reservation.total_amount, user.language, reservation.currency)&gt;</text:placeholder></text:p>
   <text:p text:style-name="Standard"><text:placeholder text:placeholder-type="text">&lt;/for&gt;</text:placeholder></text:p>
  </office:text>
 </office:body>
</office:document>

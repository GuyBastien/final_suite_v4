msgctxt "model:ir.message,text:msg_booking_capacity"
msgid ""
"The booking \"%(booking)s\" exceeds the capacity (%(capacity)s) of the "
"service \"%(service)s\" on this slot."
msgstr ""
"Rezèvasyon \"%(booking)s\" lan depase kapasite (%(capacity)s) sèvis "
"\"%(service)s\" la nan kreno sa a."

msgctxt "model:ir.message,text:msg_booking_delete_done"
msgid "You cannot delete the completed booking \"%(booking)s\"."
msgstr "Ou pa kapab efase rezèvasyon fini \"%(booking)s\" lan."

msgctxt "model:ir.message,text:msg_booking_resource_busy"
msgid ""
"The resource \"%(resource)s\" is already booked for \"%(booking)s\" (see "
"\"%(other)s\")."
msgstr "Resous \"%(resource)s\" la deja rezève pou \"%(booking)s\" (gade \"%(other)s\")."

msgctxt "model:ir.message,text:msg_resource_unique"
msgid "A resource with this name already exists in the hotel."
msgstr "Yon resous ak non sa a deja egziste nan otèl la."

msgctxt "model:ir.message,text:msg_table_busy"
msgid "The table \"%(table)s\" is already booked around %(time)s."
msgstr "Tab \"%(table)s\" la deja rezève alantou %(time)s."

msgctxt "model:ir.message,text:msg_table_seats"
msgid "The table \"%(table)s\" has %(seats)s seats, not %(covers)s."
msgstr "Tab \"%(table)s\" la gen %(seats)s plas, pa %(covers)s."

msgctxt "model:ir.message,text:msg_table_unique"
msgid "A table with this name already exists in the hotel."
msgstr "Yon tab ak non sa a deja egziste nan otèl la."


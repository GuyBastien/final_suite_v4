msgid "Deposit Rate"
msgstr "Taux d'acompte"

msgctxt "field:hotel.hotel,booking_engine_enabled:"
msgid "Online Booking"
msgstr "Réservation en ligne"

msgctxt "field:hotel.hotel,booking_lead_hours:"
msgid "Lead Time (hours)"
msgstr "Délai (heures)"

msgctxt "field:hotel.hotel,booking_max_nights:"
msgid "Maximum Nights"
msgstr "Nuits maximum"

msgctxt "field:hotel.hotel,booking_max_rooms:"
msgid "Maximum Rooms"
msgstr "Chambres maximum"

msgctxt "field:hotel.hotel,booking_token:"
msgid "Booking Token"
msgstr "Jeton de réservation"

msgctxt "field:hotel.hotel,booking_url:"
msgid "Booking Address"
msgstr "Adresse de réservation"

msgctxt "field:hotel.reservation,deposit_requested:"

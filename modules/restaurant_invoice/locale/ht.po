msgctxt "model:ir.message,text:msg_no_invoice_address"
msgid ""
"Customer \"%(party)s\" has no address: it is needed to invoice order "
"\"%(order)s\"."
msgstr ""
"Kliyan « %(party)s » la pa gen adrès : li nesesè pou fakti kòmand « "
"%(order)s » la."

msgctxt "model:ir.message,text:msg_no_revenue_account"
msgid ""
"Item \"%(product)s\" has no revenue account: it is needed to invoice order "
"\"%(order)s\"."
msgstr ""
"Atik « %(product)s » la pa gen kont revni : li nesesè pou fakti kòmand « "
"%(order)s » la."


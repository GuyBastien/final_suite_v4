msgid "Anonymized"
msgstr "Anonimize"

msgctxt "model:ir.message,text:msg_guest_blacklisted"
msgid ""
"The guest \"%(party)s\" is blacklisted: the reservation \"%(reservation)s\" "
"cannot be confirmed."
msgstr ""
"Kliyan \"%(party)s\" nan lis nwa: yo pa kapab konfime rezèvasyon "
"\"%(reservation)s\" lan."

msgctxt "model:ir.message,text:msg_guest_registration_missing"
msgid ""
"The reservation \"%(reservation)s\" needs %(needed)s guest registrations at "
"check-in but has only %(count)s."
msgstr ""
"Rezèvasyon \"%(reservation)s\" lan bezwen %(needed)s anrejistreman kliyan lè"
" yo rive men li gen sèlman %(count)s."


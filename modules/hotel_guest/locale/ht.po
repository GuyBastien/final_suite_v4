msgctxt "help:hotel.hotel,require_registration:"
msgid ""
"Require a registration card for every guest (adults and children) at check-"
"in."
msgstr ""
"Egzije yon fich anrejistreman pou chak kliyan (granmoun ak timoun) lè yo "
"rive."


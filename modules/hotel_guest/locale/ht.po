msgctxt "model:ir.message,text:msg_guest_anonymize_open"
msgid ""
"You cannot anonymize \"%(party)s\" because the guest has open reservations."
msgstr "Ou pa kapab anonimize \"%(party)s\" paske kliyan an gen rezèvasyon ouvè."


<?xml version="1.0"?>
<tryton>
    <data>
        <!-- Hotel fields on the native product form -->
        <record model="ir.ui.view" id="template_view_form">
            <field name="model">product.template</field>
            <field name="inherit" ref="product.template_view_form"/>
            <field name="name">template_form</field>
        </record>

        <!-- Hotel articles = native products flagged as hotel articles -->
        <record model="ir.action.act_window" id="act_article_form">
            <field name="name">Articles and Consumables</field>
            <field name="res_model">product.product</field>
            <field name="domain"
                eval="[('template.hotel_article', '=', True)]" pyson="1"/>
            <field name="context"
                eval="{'default_hotel_article': True}" pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_article_form_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="product.product_view_tree"/>
            <field name="act_window" ref="act_article_form"/>
        </record>
        <record model="ir.action.act_window.view" id="act_article_form_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="product.product_view_form"/>
            <field name="act_window" ref="act_article_form"/>
        </record>
        <menuitem icon="tryton-hotel-article" parent="menu_stock" action="act_article_form"
            id="menu_article_form" sequence="10"/>

        <!-- Stock moves generated by hotel operations -->
        <record model="ir.action.act_window" id="act_hotel_move_form">
            <field name="name">Hotel Stock Moves</field>
            <field name="res_model">stock.move</field>
            <field name="domain"
                eval="[('origin', 'like', 'hotel.consumption.line,%')]"
                pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_hotel_move_form_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="stock.move_view_tree"/>
            <field name="act_window" ref="act_hotel_move_form"/>
        </record>
        <record model="ir.action.act_window.view" id="act_hotel_move_form_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="stock.move_view_form"/>
            <field name="act_window" ref="act_hotel_move_form"/>
        </record>
        <menuitem icon="tryton-hotel-move" parent="menu_stock" action="act_hotel_move_form"
            id="menu_hotel_move_form" sequence="30"/>
    </data>
</tryton>

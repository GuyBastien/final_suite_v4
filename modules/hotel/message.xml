        <record model="ir.message" id="msg_hotel_code_unique">
            <field name="text">The code of the hotel must be unique per company.</field>
        </record>
        <record model="ir.message" id="msg_room_type_code_unique">
            <field name="text">The code of the room type must be unique per hotel.</field>
        </record>
        <record model="ir.message" id="msg_room_type_no_rate">
            <field name="text">No rate is defined for room type "%(room_type)s" on %(date)s.</field>
        </record>

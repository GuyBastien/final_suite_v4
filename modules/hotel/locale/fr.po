msgctxt "model:ir.message,text:msg_consumption_delete_done"
msgid "You cannot delete the done operation \"%(consumption)s\"."
msgstr ""
"Vous ne pouvez pas supprimer l'opération terminée « %(consumption)s »."

msgctxt "model:ir.message,text:msg_consumption_no_lines"
msgid "The operation \"%(consumption)s\" has no lines to process."
msgstr "L'opération « %(consumption)s » n'a aucune ligne à traiter."

msgctxt "model:ir.message,text:msg_consumption_no_room_location"
msgid "The operation \"%(consumption)s\" needs a room with a stock location."
msgstr ""
"L'opération « %(consumption)s » nécessite une chambre avec un emplacement de"
" stock."

msgctxt "model:ir.message,text:msg_hotel_code_unique"
msgid "The code of the hotel must be unique per company."
msgstr "Le code de l'hôtel doit être unique par société."

msgctxt "model:ir.message,text:msg_rate_invalid_period"
msgid "The end of the stay must be after its start."
msgstr "La fin du séjour doit être postérieure à son début."

msgctxt "model:ir.message,text:msg_rate_no_hour_price"
msgid "The rate \"%(rate)s\" has no hour price."
msgstr "Le tarif « %(rate)s » n'a pas de prix à l'heure."

msgctxt "model:ir.message,text:msg_room_name_unique"
msgid "The room number must be unique per hotel."
msgstr "Le numéro de chambre doit être unique par hôtel."

msgctxt "model:ir.message,text:msg_room_type_article_unique"
msgid "A product can be set only once per room type."
msgstr "Un produit ne peut être défini qu'une seule fois par type de chambre."

msgctxt "model:ir.message,text:msg_room_type_code_unique"
msgid "The code of the room type must be unique per hotel."
msgstr "Le code du type de chambre doit être unique par hôtel."

msgctxt "model:ir.message,text:msg_room_type_no_rate"
msgid "No rate is defined for room type \"%(room_type)s\" on %(date)s."
msgstr ""
"Aucun tarif n'est défini pour le type de chambre « %(room_type)s » au "
"%(date)s."


<?xml version="1.0"?>
<tryton>
    <data>
        <record model="ir.ui.view" id="rate_view_form">
            <field name="model">hotel.rate</field>
            <field name="type">form</field>
            <field name="name">rate_form</field>
        </record>
        <record model="ir.ui.view" id="rate_view_list">
            <field name="model">hotel.rate</field>
            <field name="type">tree</field>
            <field name="name">rate_list</field>
        </record>
        <record model="ir.action.act_window" id="act_rate_form">
            <field name="name">Rates</field>
            <field name="res_model">hotel.rate</field>
        </record>
        <record model="ir.action.act_window.view" id="act_rate_form_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="rate_view_list"/>
            <field name="act_window" ref="act_rate_form"/>
        </record>
        <record model="ir.action.act_window.view" id="act_rate_form_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="rate_view_form"/>
            <field name="act_window" ref="act_rate_form"/>
        </record>
        <menuitem icon="tryton-hotel-rate" parent="menu_configuration" action="act_rate_form"
            id="menu_rate_form" sequence="30"/>

        <record model="ir.model.access" id="access_rate">
            <field name="model" search="[('model', '=', 'hotel.rate')]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_rate_hotel">
            <field name="model" search="[('model', '=', 'hotel.rate')]"/>
            <field name="group" ref="group_hotel"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_rate_hotel_admin">
            <field name="model" search="[('model', '=', 'hotel.rate')]"/>
            <field name="group" ref="group_hotel_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
    </data>
</tryton>

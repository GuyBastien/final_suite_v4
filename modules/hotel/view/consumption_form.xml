<?xml version="1.0"?>
<!-- This file is part of the Tryton hotel module. -->
<form>
    <label name="number"/>
    <field name="number"/>
    <label name="company"/>
    <field name="company"/>
    <label name="hotel"/>
    <field name="hotel"/>
    <label name="kind"/>
    <field name="kind"/>
    <label name="room"/>
    <field name="room"/>
    <label name="date"/>
    <field name="date"/>
    <field name="lines" colspan="4"/>
    <label name="state"/>
    <field name="state"/>
    <group col="3" colspan="2" id="buttons">
        <button name="cancel" icon="tryton-cancel"/>
        <button icon="tryton-undo" name="draft"/>
        <button name="process" icon="tryton-ok"/>
    </group>
    <separator name="notes" colspan="4"/>
    <field name="notes" colspan="4"/>
</form>

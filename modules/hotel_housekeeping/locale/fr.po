msgid "Describe the resolution of the issue \"%(issue)s\" before resolving it."
msgstr ""
"Décrivez la résolution de l'anomalie « %(issue)s » avant de la résoudre."

msgctxt "model:ir.message,text:msg_task_checklist_incomplete"
msgid "Complete the required checklist items of the task \"%(task)s\" first."
msgstr ""
"Terminez d'abord les points obligatoires de la liste de contrôle de la tâche"
" « %(task)s »."

msgctxt "model:ir.message,text:msg_task_delete_state"
msgid "You cannot delete the task \"%(task)s\" because it is started or done."
msgstr ""
"Vous ne pouvez pas supprimer la tâche « %(task)s » car elle est commencée ou"
" terminée."

msgctxt "model:ir.message,text:msg_task_room_hotel"
msgid "The room \"%(room)s\" of the task \"%(task)s\" does not belong to its hotel."
msgstr ""
"La chambre « %(room)s » de la tâche « %(task)s » n'appartient pas à son "
"hôtel."


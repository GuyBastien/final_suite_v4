msgctxt "field:account.invoice,mobile_transactions:"
msgid "Mobile Payments"
msgstr "Peman mobil"

msgctxt "field:mobile.payment.account,invoice_payment_method:"
msgid "Invoice Payment Method"
msgstr "Mòd peman faktè yo"

msgctxt "field:mobile.payment.transaction,invoice:"
msgid "Invoice"
msgstr "Fakti"

msgctxt "help:account.invoice,mobile_transactions:"
msgid "MonCash, NatCash and other mobile payments of this invoice."
msgstr "Peman MonCash, NatCash ak lòt peman mobil pou faktè sa a."

msgctxt "help:mobile.payment.account,invoice_payment_method:"
msgid ""
"Payment method of the invoices (cash journal and accounts) on which the "
"confirmed payments of this operator are booked. Needed to pay invoices and "
"sales by mobile."
msgstr ""
"Mòd peman faktè yo (jounal kès ak kont) kote peman operatè sa a konfime yo "
"anrejistre. Nesesè pou peye faktè ak vant pa mobil."

msgctxt "help:mobile.payment.transaction,invoice:"
msgid "Customer invoice paid by this transaction."
msgstr "Faktè kliyan tranzaksyon sa a peye."

msgctxt "model:ir.message,text:msg_company"
msgid ""
"Transaction \"%(transaction)s\" and its invoice must belong to the same "
"company."
msgstr ""
"Tranzaksyon « %(transaction)s » la ak faktè li a dwe nan menm konpayi a."

msgctxt "model:ir.message,text:msg_currency"
msgid ""
"Invoice \"%(invoice)s\" is not in %(currency)s: only invoices in the "
"currency of the company can be paid by mobile."
msgstr ""
"Faktè « %(invoice)s » la pa an %(currency)s : se sèlman faktè ki nan lajan "
"konpayi an ki ka peye pa mobil."

msgctxt "model:ir.message,text:msg_no_invoice_method"
msgid ""
"Mobile payment account \"%(account)s\" has no Invoice Payment Method. Set it"
" to pay invoices and sales by mobile."
msgstr ""
"Kont peman mobil « %(account)s » la pa gen mòd peman faktè. Mete youn pou "
"kapab peye faktè ak vant pa mobil."

msgctxt "model:ir.message,text:msg_not_payable"
msgid ""
"Invoice \"%(invoice)s\" is not a posted customer invoice: it cannot be paid "
"by mobile."
msgstr ""
"Faktè « %(invoice)s » la pa yon faktè kliyan ki konfime : pa ka peye l pa "
"mobil."

msgctxt "model:ir.message,text:msg_nothing_due"
msgid "Invoice \"%(invoice)s\" has nothing left to pay."
msgstr "Faktè « %(invoice)s » la pa gen anyen ankò pou peye."

msgctxt "model:ir.message,text:msg_pay_description"
msgid "%(provider)s - %(reference)s"
msgstr "%(provider)s - %(reference)s"

msgctxt "model:ir.message,text:msg_sale_many_invoices"
msgid ""
"Sale \"%(sale)s\" has several invoices waiting for payment. Open the invoice"
" to pay and use \"Pay by Mobile\" there."
msgstr ""
"Vant « %(sale)s » la gen plizyè faktè k ap tann peman. Louvri faktè pou peye"
" a epi itilize « Peye pa mobil » la a."

msgctxt "model:ir.message,text:msg_sale_nothing_due"
msgid ""
"Sale \"%(sale)s\" has no posted invoice waiting for payment. Create and post"
" the invoice first."
msgstr ""
"Vant « %(sale)s » la pa gen faktè konfime k ap tann peman. Kreye epi konfime"
" faktè a anvan."

msgctxt "model:ir.model.button,string:invoice_pay_mobile_button"
msgid "Pay by Mobile"
msgstr "Peye pa mobil"

msgctxt "model:ir.model.button,string:sale_pay_mobile_button"
msgid "Pay by Mobile"
msgstr "Peye pa mobil"

msgctxt "view:account.invoice:"
msgid "Mobile Payments"
msgstr "Peman mobil"

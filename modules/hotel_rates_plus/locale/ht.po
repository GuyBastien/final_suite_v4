msgctxt "help:hotel.hotel,dynamic_pricing:"
msgid ""
"Adjust the room prices computed for a reservation with the pricing rules "
"(occupancy of the hotel and booking lead time)."
msgstr ""
"Ajiste pri chanm yo kalkile pou yon rezèvasyon ak règ pri yo (okipasyon otèl"
" la ak delè rezèvasyon)."

msgctxt "help:hotel.meal.plan,adult_price:"
msgid "Price per adult and per night."
msgstr "Pri pa granmoun ak pa nwit."

msgctxt "help:hotel.meal.plan,child_price:"
msgid "Price per child and per night."
msgstr "Pri pa timoun ak pa nwit."

msgctxt "help:hotel.meal.plan,included:"
msgid ""
"The meals are already in the room price: nothing is charged, the plan is "
"only informative."
msgstr ""
"Manje yo deja nan pri chanm nan: yo pa chaje anyen, plan an se sèlman "
"enfòmatif."

msgctxt "help:hotel.meal.plan,product:"
msgid "The service invoiced for the meals."
msgstr "Sèvis yo faktire pou manje yo."

msgctxt "help:hotel.pricing.rule,adjustment_percent:"
msgid "Percentage added to the room price (negative to lower it)."
msgstr "Pousantaj yo ajoute sou pri chanm nan (negatif pou bese l)."

msgctxt "help:hotel.pricing.rule,advance_days_max:"
msgid "Maximum number of days between the booking and the arrival."
msgstr "Maksimòm kantite jou ant rezèvasyon an ak rive a."

msgctxt "help:hotel.pricing.rule,advance_days_min:"
msgid "Minimum number of days between the booking and the arrival."
msgstr "Minimòm kantite jou ant rezèvasyon an ak rive a."

msgctxt "help:hotel.pricing.rule,priority:"
msgid "The matching rule with the highest priority applies."
msgstr "Règ ki koresponn ak pi gwo priyorite a aplike."

msgctxt "help:hotel.rate.contract,discount_rate:"
msgid ""
"Discount on the room price (0.10 for 10%). Applied to the lines of the "
"reservations that have no discount."
msgstr ""
"Rabè sou pri chanm nan (0,10 pou 10%). Aplike sou liy rezèvasyon ki pa gen "
"rabè."

msgctxt "help:hotel.rate.contract,party:"
msgid "The company or agency that benefits from the contract."
msgstr "Konpayi oswa ajans ki benefisye kontra a."

msgctxt "help:hotel.rate.contract,rate:"
msgid "Rate used instead of the public rate of the period."
msgstr "Tarif yo itilize olye tarif piblik peryòd la."

msgctxt "help:hotel.rate.contract,room_type:"
msgid "Leave empty to apply to all the room types."
msgstr "Kite vid pou aplike sou tout kalite chanm."

msgctxt "help:hotel.rate.restriction,closed:"
msgid "No stay may include a night of the period."
msgstr "Okenn sejou pa kapab gen yon nwit nan peryòd la."

msgctxt "help:hotel.rate.restriction,closed_to_arrival:"
msgid "No arrival is accepted in the period."
msgstr "Okenn rive pa aksepte nan peryòd la."

msgctxt "help:hotel.rate.restriction,closed_to_departure:"
msgid "No departure is accepted in the period."
msgstr "Okenn pati pa aksepte nan peryòd la."

msgctxt "help:hotel.rate.restriction,end_date:"
msgid "Last night concerned. Empty means no upper bound."
msgstr "Dènye nwit ki konsène. Vid vle di pa gen limit anwo."

msgctxt "help:hotel.rate.restriction,max_stay:"
msgid "Maximum number of nights for an arrival in the period."
msgstr "Maksimòm kantite nwit pou yon rive nan peryòd la."

msgctxt "help:hotel.rate.restriction,min_stay:"
msgid "Minimum number of nights for an arrival in the period."
msgstr "Minimòm kantite nwit pou yon rive nan peryòd la."

msgctxt "help:hotel.rate.restriction,room_type:"
msgid "Leave empty to apply to all the room types."
msgstr "Kite vid pou aplike sou tout kalite chanm."

msgctxt "help:hotel.rate.restriction,start_date:"
msgid "First night concerned. Empty means no lower bound."
msgstr "Premye nwit ki konsène. Vid vle di pa gen limit anba."

msgctxt "help:hotel.rate.supplement,extra_adult_price:"
msgid "Price per extra adult and per night."
msgstr "Pri pa granmoun siplemantè ak pa nwit."

msgctxt "help:hotel.rate.supplement,extra_child_price:"
msgid "Price per extra child and per night."
msgstr "Pri pa timoun siplemantè ak pa nwit."

msgctxt "help:hotel.rate.supplement,included_adults:"
msgid ""
"Number of guests (adults first, then children) included in the room price. "
"Empty means the capacity of the room type."
msgstr ""
"Kantite kliyan (granmoun an premye, apre sa timoun) ki enkli nan pri chanm "
"nan. Vid vle di kapasite kalite chanm nan."

msgctxt "help:hotel.rate.supplement,product:"
msgid "The service invoiced for the extra guests."
msgstr "Sèvis yo faktire pou kliyan siplemantè yo."

msgctxt "help:hotel.reservation,meal_plan:"
msgid "Use the button to add the meals to the charges."
msgstr "Sèvi ak bouton an pou ajoute manje yo nan chaj yo."

msgctxt "help:hotel.reservation.charge,rates_plus_kind:"
msgid ""
"Set on the charges created from a meal plan or a supplement; they are "
"replaced when the buttons are used again."
msgstr ""
"Mete sou chaj yo kreye apati yon plan manje oswa yon siplemantè; yo ranplase"
" lè yo itilize bouton yo ankò."


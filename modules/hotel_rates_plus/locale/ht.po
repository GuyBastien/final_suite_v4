msgctxt "model:ir.message,text:msg_contract_empty"
msgid "The contract \"%(contract)s\" needs a discount rate or a fixed rate."
msgstr "Kontra \"%(contract)s\" lan bezwen yon to rabè oswa yon tarif fiks."

msgctxt "model:ir.message,text:msg_label_adults"
msgid "Adults"
msgstr "Granmoun"

msgctxt "model:ir.message,text:msg_label_children"
msgid "Children"
msgstr "Pitit yo"

msgctxt "model:ir.message,text:msg_label_extra_adults"
msgid "Extra adults"
msgstr "Granmoun siplemantè"

msgctxt "model:ir.message,text:msg_label_extra_children"
msgid "Extra children"
msgstr "Timoun siplemantè"

msgctxt "model:ir.message,text:msg_meal_plan_code_unique"
msgid "The code of a meal plan must be unique per hotel."
msgstr "Kòd yon plan manje dwe inik pou chak otèl."

msgctxt "model:ir.message,text:msg_meal_plan_no_product"
msgid "Set the product of the meal plan \"%(plan)s\" to charge the meals."
msgstr "Mete pwodui plan manje \"%(plan)s\" lan pou chaje manje yo."

msgctxt "model:ir.message,text:msg_restriction_arrival"
msgid ""
"Arrivals are closed on this date for the room type \"%(room_type)s\" "
"(reservation \"%(reservation)s\")."
msgstr ""
"Rive fèmen nan dat sa a pou kalite chanm \"%(room_type)s\" (rezèvasyon "
"\"%(reservation)s\")."

msgctxt "model:ir.message,text:msg_restriction_closed"
msgid ""
"The stay of \"%(reservation)s\" includes a night closed for the room type "
"\"%(room_type)s\"."
msgstr ""
"Sejou \"%(reservation)s\" gen yon nwit ki fèmen pou kalite chanm "
"\"%(room_type)s\"."

msgctxt "model:ir.message,text:msg_restriction_departure"
msgid ""
"Departures are closed on this date for the room type \"%(room_type)s\" "
"(reservation \"%(reservation)s\")."
msgstr ""
"Pati fèmen nan dat sa a pou kalite chanm \"%(room_type)s\" (rezèvasyon "
"\"%(reservation)s\")."

msgctxt "model:ir.message,text:msg_restriction_max_stay"
msgid ""
"The reservation \"%(reservation)s\" is longer than the maximum stay of "
"%(max_stay)s nights for the room type \"%(room_type)s\"."
msgstr ""
"Rezèvasyon \"%(reservation)s\" pi long pase maksimòm sejou %(max_stay)s nwit"
" pou kalite chanm \"%(room_type)s\"."

msgctxt "model:ir.message,text:msg_restriction_min_stay"
msgid ""
"The reservation \"%(reservation)s\" is shorter than the minimum stay of "
"%(min_stay)s nights for the room type \"%(room_type)s\"."
msgstr ""
"Rezèvasyon \"%(reservation)s\" pi kout pase minimòm sejou %(min_stay)s nwit "
"pou kalite chanm \"%(room_type)s\"."

msgctxt "model:ir.message,text:msg_supplement_missing"
msgid ""
"No occupancy supplement is defined for the room types of "
"\"%(reservation)s\"."
msgstr "Pa gen siplemantè okipasyon defini pou kalite chanm \"%(reservation)s\"."

msgctxt "model:ir.message,text:msg_supplement_unique"
msgid "A room type can have only one occupancy supplement."
msgstr "Yon kalite chanm kapab gen yon sèl siplemantè okipasyon."


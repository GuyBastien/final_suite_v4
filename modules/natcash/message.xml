<?xml version="1.0"?>
<!-- This file is part of the Tryton natcash module. -->
<tryton>
    <data grouped="1">
        <record model="ir.message" id="msg_sdk_missing">
            <field name="text">The Python package "natcashify" is not installed on the server. Run: pip install natcashify</field>
        </record>
        <record model="ir.message" id="msg_config">
            <field name="text">The NatCash settings are incomplete or invalid: %(error)s</field>
        </record>
        <record model="ir.message" id="msg_api_error">
            <field name="text">NatCash refused the request: %(error)s</field>
        </record>
        <record model="ir.message" id="msg_test_ok">
            <field name="text">The NatCash settings are valid (%(mode)s mode). The connection itself is only tested by a real payment.</field>
        </record>
        <record model="ir.message" id="msg_mode_sandbox">
            <field name="text">sandbox</field>
        </record>
        <record model="ir.message" id="msg_mode_live">
            <field name="text">live</field>
        </record>
        <record model="ir.message" id="msg_currency">
            <field name="text">NatCash only accepts gourdes (HTG). The currency of the ticket is %(currency)s.</field>
        </record>
        <record model="ir.message" id="msg_waiting">
            <field name="text">Waiting for the customer on NatCash.</field>
        </record>
        <record model="ir.message" id="msg_refused">
            <field name="text">NatCash declined the payment (code %(code)s).</field>
        </record>
        <record model="ir.message" id="msg_forged">
            <field name="text">The NatCash callback signature is invalid. The request was ignored.</field>
        </record>
    </data>
</tryton>

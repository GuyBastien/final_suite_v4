msgid "Suspect"
msgstr "Suspect"

msgctxt "field:sale.point.cash.session,closing_suspect:"
msgid "Suspect at Closing"
msgstr "Suspect à la fermeture"

msgctxt "help:sale.point,cash_tolerance:"
msgid "Closing difference accepted without warning."
msgstr "Écart de fermeture accepté sans avertissement."

msgctxt "help:sale.point.cash.count,amount:"
msgid ""
"Amount in the currency of the document, without the suspect banknotes and "
"coins."
msgstr ""
"Montant dans la devise du document, sans les billets et pièces suspects."

msgctxt "help:sale.point.cash.count,suspect_amount:"
msgid "Value of banknotes or coins that look counterfeit."
msgstr "Valeur des billets ou pièces qui semblent faux."

msgctxt "help:sale.point.cash.count,suspect_quantity:"
msgid ""
"Counterfeit, damaged or doubtful banknotes/coins among those counted. They "
"are not added to the cash total."
msgstr ""
"Billets/pièces faux, abîmés ou douteux parmi ceux comptés. Ils ne sont pas "
"ajoutés au total de la caisse."

msgctxt "help:sale.point.cash.session,closing_suspect:"
msgid ""
"Value of the suspect banknotes and coins found at the closing count. They "
"are not part of the counted total."
msgstr ""
"Valeur des billets et pièces suspects trouvés au comptage de fermeture. Ils "
"ne font pas partie du total compté."

msgctxt "model:ir.message,text:msg_closing_difference"
msgid ""
"The closing count of session \"%(session)s\" differs from the expected "
"amount by %(difference)s. Close anyway? The difference will be recorded as a"
" cash transfer."
msgstr ""
"Le comptage de fermeture de la session \"%(session)s\" diffère du montant "
"attendu de %(difference)s. Fermer quand même ? L'écart sera enregistré comme"
" transfert d'espèces."

msgctxt "model:ir.message,text:msg_count_suspect"
msgid "The suspect quantity cannot be greater than the counted quantity."
msgstr "La quantité suspecte ne peut pas dépasser la quantité comptée."

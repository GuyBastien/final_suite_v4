msgctxt "model:ir.message,text:msg_laundry_delete_state"
msgid "You cannot delete the laundry batch \"%(batch)s\" because it is sent."
msgstr ""
"Vous ne pouvez pas supprimer le lot de blanchisserie « %(batch)s » car il "
"est envoyé."

msgctxt "model:ir.message,text:msg_laundry_no_lines"
msgid "The laundry batch \"%(batch)s\" has no lines."
msgstr "Le lot de blanchisserie « %(batch)s » n'a aucune ligne."

msgctxt "model:ir.message,text:msg_laundry_no_location"
msgid "Set the laundry location of the hotel \"%(hotel)s\" first."
msgstr ""
"Renseignez d'abord l'emplacement de blanchisserie de l'hôtel « %(hotel)s »."

msgctxt "model:ir.message,text:msg_laundry_returned_more"
msgid ""
"The returned quantity of \"%(product)s\" in the laundry batch \"%(batch)s\" "
"must be between 0 and the sent quantity."
msgstr ""
"La quantité retournée de « %(product)s » dans le lot de blanchisserie « "
"%(batch)s » doit être comprise entre 0 et la quantité envoyée."

msgctxt "model:ir.message,text:msg_lost_no_claimant"
msgid "Select who claims the item \"%(item)s\" first."
msgstr "Indiquez d'abord qui réclame l'objet « %(item)s »."

msgctxt "model:ir.message,text:msg_order_delete_state"
msgid ""
"You cannot delete the work order \"%(order)s\" because it is started or "
"done."
msgstr ""
"Vous ne pouvez pas supprimer l'ordre de travail « %(order)s » car il est "
"commencé ou terminé."

msgctxt "model:ir.message,text:msg_order_no_assignee"
msgid "Select who is in charge of the work order \"%(order)s\" first."
msgstr ""
"Indiquez d'abord qui est responsable de l'ordre de travail « %(order)s »."

msgctxt "model:ir.message,text:msg_order_room_hotel"
msgid ""
"The room \"%(room)s\" of the work order \"%(order)s\" does not belong to its"
" hotel."
msgstr ""
"La chambre « %(room)s » de l'ordre de travail « %(order)s » n'appartient pas"
" à son hôtel."

msgctxt "model:ir.message,text:msg_order_room_occupied"
msgid ""
"The room \"%(room)s\" is occupied: the work order \"%(order)s\" cannot block"
" it."
msgstr ""
"La chambre « %(room)s » est occupée : l'ordre de travail « %(order)s » ne "
"peut pas la bloquer."


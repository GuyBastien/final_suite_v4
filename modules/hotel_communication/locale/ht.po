msgctxt "model:ir.message,text:msg_default_cancellation_body"
msgid ""
"Dear {guest_name},\n"
"\n"
"Your reservation {reservation} at {hotel} has been cancelled."
msgstr ""
"Chè {guest_name},\n"
"\n"
"Rezèvasyon ou a {reservation} nan {hotel} anile."

msgctxt "model:ir.message,text:msg_default_cancellation_name"
msgid "Cancellation"
msgstr "Anilasyon"

msgctxt "model:ir.message,text:msg_default_cancellation_subject"
msgid "Cancellation of your reservation {reservation}"
msgstr "Anilasyon rezèvasyon ou a {reservation}"

msgctxt "model:ir.message,text:msg_default_confirmation_body"
msgid ""
"Dear {guest_name},\n"
"\n"
"Your reservation {reservation} at {hotel} is confirmed.\n"
"Arrival: {arrival}\n"
"Departure: {departure}\n"
"Total: {total} {currency}\n"
"\n"
"We look forward to welcoming you."
msgstr ""
"Chè {guest_name},\n"
"\n"
"Rezèvasyon ou a {reservation} nan {hotel} konfime.\n"
"Rive: {arrival}\n"
"Pati: {departure}\n"
"Total: {total} {currency}\n"
"\n"
"Nou ap tann pou nou akeyi ou."

msgctxt "model:ir.message,text:msg_default_confirmation_name"
msgid "Booking confirmation"
msgstr "Konfimasyon rezèvasyon"

msgctxt "model:ir.message,text:msg_default_confirmation_subject"
msgid "Your reservation {reservation} at {hotel}"
msgstr "Rezèvasyon ou a {reservation} nan {hotel}"

msgctxt "model:ir.message,text:msg_default_pre_arrival_body"
msgid ""
"Dear {guest_name},\n"
"\n"
"Your stay at {hotel} begins on {arrival}.\n"
"Please tell us your estimated arrival time: {precheckin_url}"
msgstr ""
"Chè {guest_name},\n"
"\n"
"Sejou ou nan {hotel} kòmanse {arrival}.\n"
"Tanpri di nou ki lè ou estime w ap rive: {precheckin_url}"

msgctxt "model:ir.message,text:msg_default_pre_arrival_name"
msgid "Pre-arrival"
msgstr "Anvan rive"

msgctxt "model:ir.message,text:msg_default_pre_arrival_subject"
msgid "Your arrival at {hotel}"
msgstr "Rive ou nan {hotel}"

msgctxt "model:ir.message,text:msg_default_thank_you_body"
msgid ""
"Dear {guest_name},\n"
"\n"
"Thank you for your stay at {hotel}. We hope to see you again soon."
msgstr ""
"Chè {guest_name},\n"
"\n"
"Mèsi pou sejou ou nan {hotel}. Nou espere wè w ankò talè konsa."

msgctxt "model:ir.message,text:msg_default_thank_you_name"
msgid "Thank you"
msgstr "Mèsi"

msgctxt "model:ir.message,text:msg_default_thank_you_subject"
msgid "Thank you for staying at {hotel}"
msgstr "Mèsi paske ou rete nan {hotel}"

msgctxt "model:ir.message,text:msg_message_delete_queued"
msgid "You cannot delete the queued message \"%(message)s\": cancel it first."
msgstr ""
"Ou pa kapab efase mesaj ki nan fil datant \"%(message)s\" la: anile l anvan."

msgctxt "model:ir.message,text:msg_no_sender"
msgid ""
"Set the \"from\" address in the [email] section of the configuration or an "
"e-mail on the party of the hotel \"%(hotel)s\"."
msgstr ""
"Mete adrès \"from\" nan seksyon [email] konfigirasyon an oswa yon imèl sou "
"pati otèl \"%(hotel)s\" la."

msgctxt "model:ir.message,text:msg_no_sms_url"
msgid ""
"Set \"sms_url\" in the [hotel_communication] section of the configuration to"
" send SMS."
msgstr ""
"Mete \"sms_url\" nan seksyon [hotel_communication] konfigirasyon an pou voye"
" SMS."

msgctxt "model:ir.message,text:msg_precheckin_no_message"
msgid ""
"No pre-arrival message could be queued for the reservation "
"\"%(reservation)s\": check its templates and the contact of the guest."
msgstr ""
"Pa gen mesaj anvan rive ki te kapab nan fil datant pou rezèvasyon "
"\"%(reservation)s\" lan: verifye modèl li yo ak kontak kliyan an."

msgctxt "model:ir.message,text:msg_precheckin_token_unique"
msgid "The pre-check-in token must be unique."
msgstr "Jeton pre-anrejistreman an dwe inik."

msgctxt "model:ir.message,text:msg_sms_status"
msgid "The SMS gateway answered with the status %(status)s."
msgstr "Pòtay SMS la reponn ak eta %(status)s."

msgctxt "model:ir.message,text:msg_sms_url_scheme"
msgid "The SMS gateway address \"%(url)s\" must start with http:// or https://."
msgstr "Adrès pòtay SMS \"%(url)s\" la dwe kòmanse ak http:// oswa https://."

msgctxt "model:ir.message,text:msg_template_name_unique"
msgid "The name of the message template must be unique per hotel."
msgstr "Non modèl mesaj la dwe inik pou chak otèl."

msgctxt "model:ir.message,text:msg_template_no_subject"
msgid "The e-mail template \"%(template)s\" needs a subject."
msgstr "Modèl imèl \"%(template)s\" la bezwen yon sijè."


msgctxt "help:hotel.hotel,reminder_days:"
msgid ""
"Number of days before the arrival when the pre-arrival message is sent. 0 "
"disables it."
msgstr "Kantite jou anvan rive lè yo voye mesaj anvan rive a. 0 dezaktive li."

msgctxt "help:hotel.message.template,body:"
msgid ""
"Placeholders: {guest_name}, {reservation}, {hotel}, {arrival}, {departure}, "
"{total}, {currency}, {precheckin_url}. The text is translated: the guest "
"receives the language of the party."
msgstr ""
"Plas rezève: {guest_name}, {reservation}, {hotel}, {arrival}, {departure}, "
"{total}, {currency}, {precheckin_url}. Tèks la tradui: kliyan an resevwa "
"lang pati a."

msgctxt "help:hotel.message.template,subject:"
msgid ""
"Placeholders: {guest_name}, {reservation}, {hotel}, {arrival}, {departure}, "
"{total}, {currency}, {precheckin_url}"
msgstr ""
"Plas rezève: {guest_name}, {reservation}, {hotel}, {arrival}, {departure}, "
"{total}, {currency}, {precheckin_url}"

msgctxt "help:hotel.reservation,precheckin_token:"
msgid "Secret of the pre-check-in address given to the guest."
msgstr "Sekrè adrès pre-anrejistreman yo bay kliyan an."


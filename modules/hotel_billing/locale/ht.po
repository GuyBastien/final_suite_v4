msgctxt "model:ir.message,text:msg_audit_delete_done"
msgid "You cannot delete the closed night audit \"%(audit)s\"."
msgstr "Ou pa kapab efase odit nwit fèmen \"%(audit)s\" lan."

msgctxt "model:ir.message,text:msg_audit_no_shows"
msgid "No-shows cancelled: %(reservations)s"
msgstr "Moun ki pa vini yo anile: %(reservations)s"

msgctxt "model:ir.message,text:msg_audit_unique"
msgid "The night audit of this hotel and date already exists."
msgstr "Odit nwit otèl sa a ak dat sa a deja egziste."

msgctxt "model:ir.message,text:msg_credit_limit_exceeded"
msgid ""
"The account of \"%(party)s\" would reach %(amount)s, beyond its credit limit"
" of %(limit)s."
msgstr ""
"Kont \"%(party)s\" ta rive %(amount)s, pi lwen pase limit kredi li ki se "
"%(limit)s."

msgctxt "model:ir.message,text:msg_deposit_delete_applied"
msgid ""
"You cannot delete the deposit \"%(deposit)s\" because it is applied to an "
"invoice."
msgstr "Ou pa kapab efase depo \"%(deposit)s\" paske li aplike sou yon fakti."

msgctxt "model:ir.message,text:msg_deposit_line"
msgid "Deposits received - %(reservation)s"
msgstr "Depo resevwa - %(reservation)s"

msgctxt "model:ir.message,text:msg_deposit_no_product"
msgid "Set the deposit product of the hotel \"%(hotel)s\" to deduct the deposits."
msgstr "Mete pwodui depo otèl \"%(hotel)s\" pou ka retire depo yo."

msgctxt "model:ir.message,text:msg_split_billed"
msgid "The reservation \"%(reservation)s\" is already billed."
msgstr "Rezèvasyon \"%(reservation)s\" lan deja faktire."

msgctxt "model:ir.message,text:msg_split_nothing"
msgid "There is nothing to bill for the reservation \"%(reservation)s\"."
msgstr "Pa gen anyen pou faktire pou rezèvasyon \"%(reservation)s\" lan."


msgctxt "help:hotel.hotel,deposit_product:"
msgid ""
"The service used to deduct the deposits from the invoice (use an account of "
"liabilities)."
msgstr ""
"Le service utilisé pour déduire les acomptes de la facture (utiliser un "
"compte de passif)."

msgctxt "help:hotel.reservation.charge,payer:"
msgid "Party invoiced for this charge. Empty means the guest."
msgstr "Tiers facturé pour ce frais. Vide : le client."

msgctxt "help:hotel.reservation.line,payer:"
msgid "Party invoiced for this room. Empty means the guest."
msgstr "Tiers facturé pour cette chambre. Vide : le client."

msgctxt "help:hotel.tourist.tax,amount:"
msgid "Amount per person and per night."
msgstr "Montant par personne et par nuit."

msgctxt "help:hotel.tourist.tax,max_nights:"
msgid "The tax is not due beyond this number of nights. Empty means no limit."
msgstr ""
"La taxe n'est pas due au-delà de ce nombre de nuits. Vide : aucune limite."

msgctxt "help:hotel.tourist.tax,product:"
msgid "The service invoiced for the tax."
msgstr "Le service facturé pour la taxe."

msgctxt "help:party.party,hotel_corporate:"
msgid ""
"Companies and agencies whose guests' stays are invoiced to them (city "
"ledger)."
msgstr ""
"Entreprises et agences dont les séjours des clients leur sont facturés "
"(compte client)."

msgctxt "help:party.party,hotel_credit_limit:"
msgid ""
"Reservations cannot be billed to the account beyond this amount of "
"receivable. Empty means no limit."
msgstr ""
"Les réservations ne peuvent pas être facturées au compte au-delà de ce "
"montant de créances. Vide : aucune limite."


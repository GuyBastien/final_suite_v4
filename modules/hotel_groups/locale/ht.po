msgctxt "model:ir.message,text:msg_block_too_many"
msgid ""
"You cannot block %(quantity)s rooms of the type \"%(room_type)s\": the hotel"
" has only %(rooms)s."
msgstr ""
"Ou pa kapab bloke %(quantity)s chanm kalite \"%(room_type)s\": otèl la gen "
"sèlman %(rooms)s."

msgctxt "model:ir.message,text:msg_block_unique"
msgid "A group can have only one block per room type."
msgstr "Yon gwoup kapab gen yon sèl blòk pou chak kalite chanm."

msgctxt "model:ir.message,text:msg_event_capacity"
msgid ""
"The attendees of the event \"%(event)s\" exceed the capacity (%(capacity)s) "
"of the space \"%(space)s\"."
msgstr ""
"Patisipan evènman \"%(event)s\" depase kapasite (%(capacity)s) espas "
"\"%(space)s\" la."

msgctxt "model:ir.message,text:msg_event_no_price"
msgid ""
"Set the hourly product and price of the space \"%(space)s\" to bill events."
msgstr ""
"Mete pwodui ak pri pa èdtan espas \"%(space)s\" la pou faktire evènman yo."

msgctxt "model:ir.message,text:msg_event_no_reservation"
msgid "Choose the reservation on which the event \"%(event)s\" is billed."
msgstr "Chwazi rezèvasyon kote evènman \"%(event)s\" la faktire."

msgctxt "model:ir.message,text:msg_event_overlap"
msgid ""
"The event \"%(event)s\" overlaps the event \"%(other)s\" in the space "
"\"%(space)s\"."
msgstr "Evènman \"%(event)s\" chevoche evènman \"%(other)s\" nan espas \"%(space)s\" la."

msgctxt "model:ir.message,text:msg_group_cutoff"
msgid ""
"The cut-off date of the group \"%(group)s\" must not be after its arrival "
"date."
msgstr "Dat limit gwoup \"%(group)s\" la pa dwe vini apre dat rive li."

msgctxt "model:ir.message,text:msg_group_cutoff_not_passed"
msgid "The cut-off date of the group \"%(group)s\" is not set or not yet passed."
msgstr "Dat limit gwoup \"%(group)s\" la pa fikse oswa li poko pase."

msgctxt "model:ir.message,text:msg_group_delete_reservations"
msgid "You cannot delete the group \"%(group)s\" because it has reservations."
msgstr "Ou pa kapab efase gwoup \"%(group)s\" la paske li gen rezèvasyon."

msgctxt "model:ir.message,text:msg_group_no_blocks"
msgid "Add at least one room block to the group \"%(group)s\"."
msgstr "Ajoute omwen yon blòk chanm nan gwoup \"%(group)s\" la."

msgctxt "model:ir.message,text:msg_space_unique"
msgid "The event space name must be unique in a hotel."
msgstr "Non espas evènman an dwe inik nan yon otèl."


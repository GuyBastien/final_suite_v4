msgctxt "help:hotel.event,reservation:"
msgid "The reservation of the group on which the space is charged."
msgstr "Rezèvasyon gwoup la kote yo chaje espas la."

msgctxt "help:hotel.event.space,product:"
msgid "The service product invoiced for each hour of use."
msgstr "Pwodui sèvis yo faktire pou chak èdtan itilizasyon."

msgctxt "help:hotel.group,cutoff_date:"
msgid ""
"After this date the blocked rooms that were not picked up can be released."
msgstr "Apre dat sa a yo kapab lage chanm ki bloke yo ki pa t ranmase."

msgctxt "help:hotel.group,party:"
msgid "The party invoiced and used as guest of the generated reservations."
msgstr "Pati yo faktire e yo itilize kòm kliyan rezèvasyon yo jenere yo."

msgctxt "help:hotel.group.block,nightly_price:"
msgid ""
"Negotiated price of a night. Empty uses the hotel rates when the reservation"
" is confirmed."
msgstr ""
"Pri negosye yon nwit. Vid itilize tarif otèl la lè yo konfime rezèvasyon an."


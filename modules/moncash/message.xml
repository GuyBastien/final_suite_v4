<?xml version="1.0"?>
<!-- This file is part of the Tryton moncash module. -->
<tryton>
    <data grouped="1">
        <record model="ir.message" id="msg_auth_failed">
            <field name="text">MonCash refused the credentials (HTTP %(status)s). Check the Client ID, the Secret Key and the Sandbox box.</field>
        </record>
        <record model="ir.message" id="msg_test_ok">
            <field name="text">MonCash accepted the credentials (%(mode)s mode).</field>
        </record>
        <record model="ir.message" id="msg_mode_sandbox">
            <field name="text">sandbox</field>
        </record>
        <record model="ir.message" id="msg_mode_live">
            <field name="text">live</field>
        </record>
        <record model="ir.message" id="msg_currency">
            <field name="text">MonCash only accepts gourdes (HTG). The currency of the ticket is %(currency)s.</field>
        </record>
        <record model="ir.message" id="msg_create_failed">
            <field name="text">MonCash did not create the payment (HTTP %(status)s): %(detail)s</field>
        </record>
        <record model="ir.message" id="msg_waiting">
            <field name="text">Waiting for the customer on MonCash.</field>
        </record>
        <record model="ir.message" id="msg_check_failed">
            <field name="text">MonCash could not verify the payment (HTTP %(status)s). Try again in a moment.</field>
        </record>
    </data>
</tryton>

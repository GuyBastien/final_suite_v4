msgctxt "model:ir.message,text:msg_booking_period"
msgid "The end of the booking is not after its start."
msgstr "La fin de la réservation n'est pas postérieure à son début."

msgctxt "model:ir.message,text:msg_booking_uid_unique"
msgid "This booking is already imported for the room."
msgstr "Cette réservation est déjà importée pour la chambre."

msgctxt "model:ir.message,text:msg_booking_unavailable"
msgid "The room %(room)s is not available between %(start)s and %(end)s."
msgstr "La chambre %(room)s n'est pas disponible entre %(start)s et %(end)s."

msgctxt "model:ir.message,text:msg_ch_conflict"
msgid ""
"The %(channel)s booking \"%(summary)s\" from %(start)s to %(end)s cannot be "
"accepted: the room is not free."
msgstr ""
"La réservation %(channel)s « %(summary)s » du %(start)s au %(end)s ne peut "
"pas être acceptée : la chambre n'est pas libre."

msgctxt "model:ir.message,text:msg_ch_conflict_title"
msgid "Overbooking: room %(room)s (%(channel)s)"
msgstr "Surréservation : chambre %(room)s (%(channel)s)"

msgctxt "model:ir.message,text:msg_ch_error"
msgid "The calendar of room %(room)s cannot be imported: %(error)s"
msgstr ""
"Le calendrier de la chambre %(room)s ne peut pas être importé : %(error)s"

msgctxt "model:ir.message,text:msg_ch_error_title"
msgid "Synchronization failed: %(channel)s"
msgstr "Échec de la synchronisation : %(channel)s"

msgctxt "model:ir.message,text:msg_channel_fetch"
msgid "The calendar cannot be read: %(error)s"
msgstr "Le calendrier ne peut pas être lu : %(error)s"

msgctxt "model:ir.message,text:msg_channel_too_large"
msgid "The calendar is too large."
msgstr "Le calendrier est trop volumineux."

msgctxt "model:ir.message,text:msg_channel_url_scheme"
msgid "Only http and https calendar addresses are allowed."
msgstr "Seules les adresses de calendrier http et https sont autorisées."

msgctxt "model:ir.message,text:msg_mapping_room_hotel"
msgid "The room \"%(room)s\" does not belong to the hotel of the channel."
msgstr "La chambre « %(room)s » n'appartient pas à l'hôtel du canal."

msgctxt "model:ir.message,text:msg_mapping_room_unique"
msgid "A room can be linked only once to a channel."
msgstr "Une chambre ne peut être liée qu'une fois à un canal."

msgctxt "model:ir.message,text:msg_mapping_token_unique"
msgid "The token of the room calendar must be unique."
msgstr "Le jeton du calendrier de la chambre doit être unique."


msgctxt "help:hotel.channel,compute_prices:"
msgid ""
"Price the imported reservations with the hotel rates. Otherwise they are "
"created at price 0 (the channel collects the payment)."
msgstr ""
"Fikse pri rezèvasyon enpòte yo ak tarif otèl la. Sinon yo kreye ak pri 0 "
"(kanal la ranmase peman an)."

msgctxt "help:hotel.channel,party:"
msgid ""
"The party of the reservations coming from the channel (usually the OTA "
"itself)."
msgstr "Pati rezèvasyon ki soti nan kanal la (anjeneral OTA a menm)."

msgctxt "help:hotel.channel.mapping,export_path:"
msgid ""
"Give the channel this address (prefixed by the server URL): it publishes the"
" occupancy of the room."
msgstr ""
"Bay kanal la adrès sa a (ak URL sèvè a devan): li pibliye okipasyon chanm "
"nan."

msgctxt "help:hotel.channel.mapping,external_id:"
msgid "The identifier of the room on the channel."
msgstr "Idantifyan chanm nan sou kanal la."

msgctxt "help:hotel.channel.mapping,import_url:"
msgid ""
"The iCal address of the room calendar published by the channel. Its "
"reservations block the room."
msgstr ""
"Adrès iCal kalandriye chanm nan kanal la pibliye. Rezèvasyon li yo bloke "
"chanm nan."

msgctxt "help:hotel.channel.mapping,token:"
msgid "Secret of the export address."
msgstr "Sekrè adrès ekspòtasyon an."

msgctxt "help:hotel.reservation,channel:"
msgid "The distribution channel the reservation comes from."
msgstr "Kanal distribisyon rezèvasyon an soti ladan l."

msgctxt "help:hotel.reservation,external_reference:"
msgid "The reference of the reservation on the channel."
msgstr "Referans rezèvasyon an sou kanal la."


            <field name="model" search="[('model', '=', 'hotel.channel.mapping')]"/>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_hotel_channel_mapping_companies">
            <field name="domain"
                eval="[('company', 'in', Eval('companies', []))]"
                pyson="1"/>
            <field name="rule_group" ref="rule_group_hotel_channel_mapping_companies"/>
        </record>
        <record model="ir.model.access" id="access_hotel_channel_booking">
            <field name="model" search="[('model', '=', 'hotel.channel.booking')]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_hotel_channel_booking_hotel">
            <field name="model" search="[('model', '=', 'hotel.channel.booking')]"/>
            <field name="group" ref="hotel.group_hotel"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.rule.group" id="rule_group_hotel_channel_booking_companies">
            <field name="name">User in companies</field>
            <field name="model" search="[('model', '=', 'hotel.channel.booking')]"/>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_hotel_channel_booking_companies">
            <field name="domain"
                eval="[('company', 'in', Eval('companies', []))]"
                pyson="1"/>
            <field name="rule_group" ref="rule_group_hotel_channel_booking_companies"/>
        </record>
        <record model="ir.model.access" id="access_hotel_channel_log">
            <field name="model" search="[('model', '=', 'hotel.channel.log')]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_hotel_channel_log_hotel">
            <field name="model" search="[('model', '=', 'hotel.channel.log')]"/>
            <field name="group" ref="hotel.group_hotel"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.rule.group" id="rule_group_hotel_channel_log_companies">
            <field name="name">User in companies</field>
            <field name="model" search="[('model', '=', 'hotel.channel.log')]"/>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_hotel_channel_log_companies">
            <field name="domain"
                eval="[('company', 'in', Eval('companies', []))]"
                pyson="1"/>
            <field name="rule_group" ref="rule_group_hotel_channel_log_companies"/>
        </record>
        <record model="ir.cron" id="cron_channels">
            <field name="method">hotel.channel|synchronize_all</field>
            <field name="interval_number" eval="30"/>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</tryton>

msgstr "Pompes de la station."

msgctxt "help:fuel.station,shift_max_hours:"
msgid ""
"A shift still open after this number of hours raises a notification to the "
"station managers."
msgstr ""
"Un poste encore ouvert après ce nombre d'heures déclenche une notification "
"aux responsables de la station."

msgctxt "help:fuel.station,tanks:"
msgid "Tanks of the station."
msgstr "Cuves de la station."

msgctxt "help:fuel.station,temperature_correction:"
msgid ""
"Deliveries and dips are booked in the stock at the volume corrected to 15 °C"
" when the temperature is entered."
msgstr ""
"Les livraisons et jaugeages sont comptabilisés en stock au volume corrigé à "
"15 °C lorsque la température est saisie."


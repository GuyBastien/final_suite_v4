msgstr "Identifiant court et unique."

msgctxt "help:fuel.tank,fill_ratio:"
msgid "Percentage of the capacity filled."
msgstr "Pourcentage de la capacité rempli."

msgctxt "help:fuel.tank,free_space:"
msgid "Volume that can still be received."
msgstr "Volume pouvant encore être reçu."

msgctxt "help:fuel.tank,location:"

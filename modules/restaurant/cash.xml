<?xml version="1.0"?>
<!-- This file is part of the Tryton restaurant module. -->
<tryton>
    <data>
        <record model="ir.ui.view" id="cash_count_view_form">
            <field name="model">restaurant.cash.count</field>
            <field name="type">form</field>
            <field name="name">cash_count_form</field>
        </record>
        <record model="ir.ui.view" id="cash_count_view_list">
            <field name="model">restaurant.cash.count</field>
            <field name="type">tree</field>
            <field name="name">cash_count_list</field>
        </record>
        <record model="ir.ui.view" id="cash_count_view_edit_list">
            <field name="model">restaurant.cash.count</field>
            <field name="type">tree</field>
            <field name="name">cash_count_edit_list</field>
        </record>
        <record model="ir.model.access" id="access_cash_count">
            <field name="model" search="[('model', '=', 'restaurant.cash.count')]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_cash_count_service">
            <field name="model" search="[('model', '=', 'restaurant.cash.count')]"/>
            <field name="group" ref="group_restaurant"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_cash_count_kitchen">
            <field name="model" search="[('model', '=', 'restaurant.cash.count')]"/>
            <field name="group" ref="group_restaurant_kitchen"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_cash_count_admin">
            <field name="model" search="[('model', '=', 'restaurant.cash.count')]"/>
            <field name="group" ref="group_restaurant_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.rule.group" id="rule_group_cash_count">
            <field name="name">User in companies</field>
            <field name="model" search="[('model', '=', 'restaurant.cash.count')]"/>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_cash_count">
            <field name="domain" eval="[('session_company', 'in', Eval('companies', []))]" pyson="1"/>
            <field name="rule_group" ref="rule_group_cash_count"/>
        </record>
        <record model="ir.ui.view" id="cash_session_view_form">
            <field name="model">restaurant.cash.session</field>
            <field name="type">form</field>
            <field name="name">cash_session_form</field>
        </record>
        <record model="ir.ui.view" id="cash_session_view_list">
            <field name="model">restaurant.cash.session</field>
            <field name="type">tree</field>
            <field name="name">cash_session_list</field>
        </record>
        <record model="ir.action.act_window" id="act_cash_session">
            <field name="name">Cash Sessions</field>
            <field name="res_model">restaurant.cash.session</field>
        </record>
        <record model="ir.action.act_window.view" id="act_cash_session_view_10">
            <field name="sequence" eval="10"/>
            <field name="view" ref="cash_session_view_list"/>
            <field name="act_window" ref="act_cash_session"/>
        </record>
        <record model="ir.action.act_window.view" id="act_cash_session_view_20">
            <field name="sequence" eval="20"/>
            <field name="view" ref="cash_session_view_form"/>
            <field name="act_window" ref="act_cash_session"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_cash_session_domain_0">
            <field name="name">Open</field>
            <field name="sequence" eval="10"/>
            <field name="domain" eval="[('state', '!=', 'closed')]" pyson="1"/>
            <field name="act_window" ref="act_cash_session"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_cash_session_domain_1">
            <field name="name">Closed</field>
            <field name="sequence" eval="20"/>
            <field name="domain" eval="[('state', '=', 'closed')]" pyson="1"/>
            <field name="act_window" ref="act_cash_session"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_cash_session_domain_2">
            <field name="name">All</field>
            <field name="sequence" eval="30"/>
            <field name="domain" eval="[]" pyson="1"/>
            <field name="act_window" ref="act_cash_session"/>
        </record>
        <menuitem icon="tryton-restaurant-cash" name="Cash Sessions" parent="menu_service" id="menu_cash_session" sequence="60" action="act_cash_session"/>
        <record model="ir.model.access" id="access_cash_session">
            <field name="model" search="[('model', '=', 'restaurant.cash.session')]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_cash_session_service">
            <field name="model" search="[('model', '=', 'restaurant.cash.session')]"/>
            <field name="group" ref="group_restaurant"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_cash_session_kitchen">
            <field name="model" search="[('model', '=', 'restaurant.cash.session')]"/>
            <field name="group" ref="group_restaurant_kitchen"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_cash_session_admin">
            <field name="model" search="[('model', '=', 'restaurant.cash.session')]"/>
            <field name="group" ref="group_restaurant_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.rule.group" id="rule_group_cash_session">
            <field name="name">User in companies</field>
            <field name="model" search="[('model', '=', 'restaurant.cash.session')]"/>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_cash_session">
            <field name="domain" eval="[('company', 'in', Eval('companies', []))]" pyson="1"/>
            <field name="rule_group" ref="rule_group_cash_session"/>
        </record>
        <record model="ir.model.button" id="cash_session_open__button">
            <field name="model" search="[('model', '=', 'restaurant.cash.session')]"/>
            <field name="name">open_</field>
            <field name="string">Open Cash Session</field>
        </record>
        <record model="ir.model.button" id="cash_session_close_button">
            <field name="model" search="[('model', '=', 'restaurant.cash.session')]"/>
            <field name="name">close</field>
            <field name="string">Close Cash Session</field>
        </record>
        <record model="ir.model.button" id="cash_session_fill_opening_button">
            <field name="model" search="[('model', '=', 'restaurant.cash.session')]"/>
            <field name="name">fill_opening</field>
            <field name="string">Fill Denominations</field>
        </record>
        <record model="ir.model.button" id="cash_session_fill_closing_button">
            <field name="model" search="[('model', '=', 'restaurant.cash.session')]"/>
            <field name="name">fill_closing</field>
            <field name="string">Fill Denominations</field>
        </record>
        <record model="ir.sequence.type" id="sequence_type_cash">
            <field name="name">Restaurant Cash Session</field>
        </record>
        <record model="ir.sequence.type-res.group" id="sequence_type_cash_group_admin">
            <field name="sequence_type" ref="sequence_type_cash"/>
            <field name="group" ref="res.group_admin"/>
        </record>
        <record model="ir.sequence.type-res.group" id="sequence_type_cash_group_service">
            <field name="sequence_type" ref="sequence_type_cash"/>
            <field name="group" ref="group_restaurant"/>
        </record>
        <record model="ir.sequence" id="sequence_cash">
            <field name="name">Restaurant Cash Session</field>
            <field name="sequence_type" ref="sequence_type_cash"/>
            <field name="prefix">CAI/</field>
        </record>
    </data>
</tryton>

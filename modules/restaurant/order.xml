        </record>
        <record model="ir.action.act_window.view" id="act_bar_view_20">
            <field name="sequence" eval="20"/>
            <field name="view" ref="order_line_view_form"/>
            <field name="act_window" ref="act_bar"/>
        </record>
        <menuitem icon="tryton-restaurant-bar" name="Bar Screen" parent="menu_service" id="menu_bar" sequence="40" action="act_bar"/>
        <record model="ir.model.access" id="access_order">

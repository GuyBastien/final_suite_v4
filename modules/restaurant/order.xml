<?xml version="1.0"?>
<!-- This file is part of the Tryton restaurant module. -->
<tryton>
    <data>
        <record model="ir.ui.view" id="order_view_form">
            <field name="model">restaurant.order</field>
            <field name="type">form</field>
            <field name="name">order_form</field>
        </record>
        <record model="ir.ui.view" id="order_view_list">
            <field name="model">restaurant.order</field>
            <field name="type">tree</field>
            <field name="name">order_list</field>
        </record>
        <record model="ir.ui.view" id="order_line_view_form">
            <field name="model">restaurant.order.line</field>
            <field name="type">form</field>
            <field name="name">order_line_form</field>
        </record>
        <record model="ir.ui.view" id="order_line_view_list_edit">
            <field name="model">restaurant.order.line</field>
            <field name="type">tree</field>
            <field name="name">order_line_list_edit</field>
        </record>
        <record model="ir.ui.view" id="order_line_view_list">
            <field name="model">restaurant.order.line</field>
            <field name="type">tree</field>
            <field name="name">order_line_list</field>
        </record>
        <record model="ir.ui.view" id="payment_view_form">
            <field name="model">restaurant.payment</field>
            <field name="type">form</field>
            <field name="name">payment_form</field>
        </record>
        <record model="ir.ui.view" id="payment_view_list">
            <field name="model">restaurant.payment</field>
            <field name="type">tree</field>
            <field name="name">payment_list</field>
        </record>
        <record model="ir.action.act_window" id="act_order">
            <field name="name">Orders</field>
            <field name="res_model">restaurant.order</field>
        </record>
        <record model="ir.action.act_window.view" id="act_order_view_10">
            <field name="sequence" eval="10"/>
            <field name="view" ref="order_view_list"/>
            <field name="act_window" ref="act_order"/>
        </record>
        <record model="ir.action.act_window.view" id="act_order_view_20">
            <field name="sequence" eval="20"/>
            <field name="view" ref="order_view_form"/>
            <field name="act_window" ref="act_order"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_order_domain_0">
            <field name="name">Open</field>
            <field name="sequence" eval="10"/>
            <field name="domain" eval="[('state', '=', 'open')]" pyson="1"/>
            <field name="act_window" ref="act_order"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_order_domain_1">
            <field name="name">Dine-in</field>
            <field name="sequence" eval="20"/>
            <field name="domain" eval="[('type', 'in', ['dine_in', 'bar_tab']), ('state', '=', 'open')]" pyson="1"/>
            <field name="act_window" ref="act_order"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_order_domain_2">
            <field name="name">Takeaway</field>
            <field name="sequence" eval="30"/>
            <field name="domain" eval="[('type', '=', 'takeaway'), ('state', '=', 'open')]" pyson="1"/>
            <field name="act_window" ref="act_order"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_order_domain_3">
            <field name="name">Paid</field>
            <field name="sequence" eval="40"/>
            <field name="domain" eval="[('state', '=', 'paid')]" pyson="1"/>
            <field name="act_window" ref="act_order"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_order_domain_4">
            <field name="name">All</field>
            <field name="sequence" eval="50"/>
            <field name="domain" eval="[]" pyson="1"/>
            <field name="act_window" ref="act_order"/>
        </record>
        <menuitem icon="tryton-restaurant-order" name="Orders" parent="menu_service" id="menu_order" sequence="10" action="act_order"/>
        <record model="ir.action.act_window" id="act_delivery_order">
            <field name="name">Deliveries</field>
            <field name="res_model">restaurant.order</field>
            <field name="domain" eval="[('type', '=', 'delivery')]" pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_delivery_order_view_10">
            <field name="sequence" eval="10"/>
            <field name="view" ref="order_view_list"/>
            <field name="act_window" ref="act_delivery_order"/>
        </record>
        <record model="ir.action.act_window.view" id="act_delivery_order_view_20">
            <field name="sequence" eval="20"/>
            <field name="view" ref="order_view_form"/>
            <field name="act_window" ref="act_delivery_order"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_delivery_order_domain_0">
            <field name="name">To Deliver</field>
            <field name="sequence" eval="10"/>
            <field name="domain" eval="[('type', '=', 'delivery'), ('state', '=', 'open'), ('delivery_state', 'in', ['pending', 'assigned', 'on_the_way'])]" pyson="1"/>
            <field name="act_window" ref="act_delivery_order"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_delivery_order_domain_1">
            <field name="name">Delivered</field>
            <field name="sequence" eval="20"/>
            <field name="domain" eval="[('type', '=', 'delivery'), ('delivery_state', '=', 'delivered')]" pyson="1"/>
            <field name="act_window" ref="act_delivery_order"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_delivery_order_domain_2">
            <field name="name">All</field>
            <field name="sequence" eval="30"/>
            <field name="domain" eval="[('type', '=', 'delivery')]" pyson="1"/>
            <field name="act_window" ref="act_delivery_order"/>
        </record>
        <menuitem icon="tryton-restaurant-delivery" name="Deliveries" parent="menu_service" id="menu_delivery_order" sequence="50" action="act_delivery_order"/>
        <record model="ir.action.act_window" id="act_kitchen">
            <field name="name">Kitchen Screen</field>
            <field name="res_model">restaurant.order.line</field>
            <field name="domain" eval="[('station', '=', 'kitchen'), ('state', 'in', ['sent', 'preparing', 'ready'])]" pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_kitchen_view_10">

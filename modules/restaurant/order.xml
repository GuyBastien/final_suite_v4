        </record>
        <menuitem icon="tryton-restaurant-kitchen" name="Kitchen Screen" parent="menu_service" id="menu_kitchen" sequence="30" action="act_kitchen"/>
        <record model="ir.action.act_window" id="act_bar">
            <field name="name">Bar Screen</field>
            <field name="res_model">restaurant.order.line</field>

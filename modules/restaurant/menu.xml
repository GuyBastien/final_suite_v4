        </record>
        <record model="ir.action.act_window.view" id="act_menu_item_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="product.product_view_form"/>
            <field name="act_window" ref="act_menu_item"/>
        </record>
        <menuitem icon="tryton-restaurant-menu" name="Menu Items" parent="menu_menu" id="menu_menu_item" sequence="10" action="act_menu_item"/>

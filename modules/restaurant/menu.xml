        <record model="ir.ui.view" id="template_view_form">
            <field name="model">product.template</field>
            <field name="inherit" ref="product.template_view_form"/>
            <field name="name">template_form</field>
        </record>
        <record model="ir.action.act_window" id="act_menu_item">
            <field name="name">Menu Items</field>
            <field name="res_model">product.product</field>
            <field name="domain" eval="[('template.restaurant_item', '=', True)]" pyson="1"/>
            <field name="context" eval="{'default_restaurant_item': True}" pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_menu_item_view1">
            <field name="sequence" eval="10"/>

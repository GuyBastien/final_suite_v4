msgctxt "help:product.template,course:"
msgid "Course of the menu in which the item is served."
msgstr "Kou nan meni kote yo sèvi atik la."

msgctxt "help:product.template,prep_minutes:"
msgid ""
"Ideal preparation time of this item, in minutes. Empty uses the ideal time "
"of the kitchen or of the bar of the restaurant."
msgstr ""
"Tan preparasyon ideyal atik sa a, an minit. Vid: tan ideyal kizin nan oswa "
"ba restoran an."

msgctxt "help:product.template,prep_station:"
msgid "Where the item is prepared: its ticket appears on this screen."
msgstr "Kote yo prepare atik la : tikè a parèt sou ekran sa a."

msgctxt "help:product.template,recipe:"
msgid "Ingredients used to prepare the item."
msgstr "Engredyan yo itilize pou prepare atik la."

msgctxt "help:product.template,restaurant_item:"
msgid "Dish or drink sold in the restaurant and the bar."
msgstr "Plat oswa bwason yo vann nan restoran an ak nan ba a."

msgctxt "help:product.template,sold_out:"
msgid "Temporarily unavailable: it can no longer be ordered."
msgstr "Pa disponib pou kounye a : yo pa ka kòmande l ankò."

msgctxt "help:product.template,track_stock:"
msgid ""
"Deduct the item itself from the stock when it is sold (bottled drinks). "
"Items with a recipe deduct their ingredients."
msgstr ""
"Retire atik la menm nan estòk lè yo vann li (bwason nan boutèy). Atik ki gen"
" yon resèt retire engredyan yo."

msgctxt "help:restaurant.area,name:"
msgid "Dining room, terrace, bar, private room..."
msgstr "Sal manje, teras, ba, sal prive..."

msgctxt "help:restaurant.area,restaurant:"
msgid "Restaurant concerned."
msgstr "Restoran ki konsène a."

msgctxt "help:restaurant.area,tables:"
msgid "Tables of the restaurant."
msgstr "Tab restoran an."

msgctxt "help:restaurant.cash.count,amount:"
msgid "Amount in the currency of the document."
msgstr "Montan nan lajan dokiman an."

msgctxt "help:restaurant.cash.count,currency:"
msgid "Currency of the amounts."
msgstr "Lajan montan yo."

msgctxt "help:restaurant.cash.count,denomination:"
msgid ""
"Banknote or coin value counted. The denominations are shared with the points"
" of sale (Sales > Denominations)."
msgstr ""
"Valè biyè oswa pyès lajan ki konte a. Valè yo pataje ak pwen vant yo (Vant >"
" Valè biyè ak pyès)."

msgctxt "help:restaurant.cash.count,face_value:"
msgid "Face value of the banknote or coin."
msgstr "Valè ki make sou biyè a oswa sou pyès la."

msgctxt "help:restaurant.cash.count,kind:"
msgid "Banknote or coin."
msgstr "Biyè oswa pyès."

msgctxt "help:restaurant.cash.count,moment:"
msgid "Opening or closing of the session."
msgstr "Ouvèti oswa fèmti sesyon an."

msgctxt "help:restaurant.cash.count,quantity:"
msgid "Number of banknotes or coins counted in the drawer."
msgstr "Kantite biyè oswa pyès yo konte nan tiwa a."

msgctxt "help:restaurant.cash.count,session:"
msgid "Cash session concerned."
msgstr "Sesyon kès ki konsène a."

msgctxt "help:restaurant.cash.count,session_company:"
msgid "Company of the cash session."
msgstr "Konpayi sesyon kès la."

msgctxt "help:restaurant.cash.count,suspect_amount:"
msgid "Value of banknotes or coins that look counterfeit."
msgstr "Valè biyè oswa pyès ki sanble fo."

msgctxt "help:restaurant.cash.count,suspect_quantity:"
msgid ""
"Counterfeit, damaged or doubtful banknotes/coins among those counted. They "
"are not added to the cash total."
msgstr ""
"Biyè/pyès fo, domaje oswa dout pami sa yo konte yo. Yo pa ajoute yo nan "
"total lajan kach la."

msgctxt "help:restaurant.cash.session,cash_sales:"
msgid "Sales collected in cash."
msgstr "Vant yo ranmase an lajan kach."

msgctxt "help:restaurant.cash.session,cashier:"
msgid "User who runs the cash session."
msgstr "Itilizatè ki jere sesyon kès la."

msgctxt "help:restaurant.cash.session,closed_at:"
msgid "Date and time of the closing."
msgstr "Dat ak lè fèmti a."

msgctxt "help:restaurant.cash.session,closing_amount:"
msgid "Total cash counted when the session is closed."
msgstr "Total lajan kach yo konte lè sesyon an fèmen."

msgctxt "help:restaurant.cash.session,closing_counts:"
msgid "Banknotes and coins counted when closing."
msgstr "Biyè ak pyès yo konte lè yo fèmen."

msgctxt "help:restaurant.cash.session,company:"
msgid "Company that owns the record."
msgstr "Konpayi ki posede done sa a."

msgctxt "help:restaurant.cash.session,counts:"
msgid "Count of banknotes and coins by denomination."
msgstr "Konte biyè ak pyès pa valè."

msgctxt "help:restaurant.cash.session,currency:"
msgid "Currency of the amounts."
msgstr "Lajan montan yo."

msgctxt "help:restaurant.cash.session,date:"
msgid "Date of the document."
msgstr "Dat dokiman an."

msgctxt "help:restaurant.cash.session,difference:"
msgid "Difference between counted and expected amounts."
msgstr "Diferans ant montan yo konte ak montan yo atann."

msgctxt "help:restaurant.cash.session,expected_amount:"
msgid "Opening cash plus cash payments received."
msgstr "Lajan kach ouvèti plis peman an lajan kach yo resevwa."

msgctxt "help:restaurant.cash.session,notes:"
msgid "Free text for internal use."
msgstr "Tèks lib pou itilizasyon entèn."

msgctxt "help:restaurant.cash.session,number:"
msgid "Number assigned automatically by the sequence."
msgstr "Nimewo sekans lan bay otomatikman."

msgctxt "help:restaurant.cash.session,opened_at:"
msgid "Date and time of the opening."
msgstr "Dat ak lè ouvèti a."

msgctxt "help:restaurant.cash.session,opening_amount:"

<?xml version="1.0"?>
<!-- This file is part of the Tryton restaurant module. -->
<tryton>
    <data>
        <record model="ir.ui.view" id="template_screen_view_form">
            <field name="model">product.template</field>
            <field name="inherit" ref="template_view_form"/>
            <field name="name">template_screen_form</field>
        </record>
        <record model="ir.ui.view" id="restaurant_screen_view_form">
            <field name="model">restaurant.restaurant</field>
            <field name="inherit" ref="restaurant_view_form"/>
            <field name="name">restaurant_screen_form</field>
        </record>
        <record model="ir.cron" id="cron_notify_delays">
            <field name="method">restaurant.order.line|notify_delays</field>
            <field name="interval_number" eval="1"/>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</tryton>
